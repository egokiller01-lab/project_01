---
import type { CTA } from '../types';

type Props = {
  title: string;
  summary: string;
  ctas: CTA[];
};

const { title, summary, ctas } = Astro.props;
---

<section class="cta-panel" id="contact">
  <div>
    <h2>{title}</h2>
    <p>{summary}</p>
  </div>
  <div class="cta-actions">
    {ctas.map((cta) => <a class={`button button--${cta.variant ?? 'secondary'}`} href={cta.href}>{cta.label}</a>)}
  </div>
</section>

<style>
  .cta-panel {
    align-items: center;
    background: var(--color-navy);
    border-radius: var(--radius-md);
    color: white;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
  }

  h2 {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    margin: 0;
  }

  p {
    margin: var(--space-2) 0 0;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 64rem) {
    .cta-panel {
      grid-template-columns: 1fr auto;
    }
  }
</style>
