---
import BlogCard from "./BlogCard.astro";
import CTAPanel from "./CTAPanel.astro";
import ProductFamilyCard from "./ProductFamilyCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedPath } from "../data/navigation";
import {
  companyFacts,
  getStaticPage,
  pageLabels,
  verifiedBlogLinks,
  type StaticPageKey,
} from "../data/pages";
import { getProductFamilies } from "../data/products";
import type { Locale } from "../types";

type Props = {
  locale: Locale;
  pageKey: StaticPageKey;
};

const { locale, pageKey } = Astro.props;
const page = getStaticPage(locale, pageKey);
const products = getProductFamilies(locale);
const blogs = verifiedBlogLinks[locale];
const locales: Locale[] = ["ko", "en", "vi"];
const alternatePaths = Object.fromEntries(
  locales.map((targetLocale) => [targetLocale, localizedPath(targetLocale, pageKey)]),
) as Record<Locale, string>;
const cardLabels = {
  ko: { material: "소재", process: "공정" },
  en: { material: "Material", process: "Process" },
  vi: { material: "Vật liệu", process: "Quy trình" },
}[locale];
const contactLabels = {
  ko: {
    vietnam: "베트남 법인",
    korea: "한국 연락처",
    phone: "전화",
    address: "주소",
  },
  en: {
    vietnam: "Vietnam office",
    korea: "Korea contact",
    phone: "Phone",
    address: "Address",
  },
  vi: {
    vietnam: "Văn phòng Việt Nam",
    korea: "Liên hệ Hàn Quốc",
    phone: "Điện thoại",
    address: "Địa chỉ",
  },
}[locale];
---

<BaseLayout
  locale={locale}
  title={page.seoTitle}
  description={page.description}
  pageKey={page.key}
  alternatePaths={alternatePaths}
>
  <section class="page-hero">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>{page.title}</h1>
        <p class="lead">{page.lead}</p>
        <a class="button button--primary" href={page.ctaHref}>{page.ctaLabel}</a>
      </div>
      <div class="process-visual" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <strong>{pageLabels[locale][pageKey].short}</strong>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      {page.sections.map((section) => (
        <article class="info-panel">
          {section.eyebrow && <p class="panel-eyebrow">{section.eyebrow}</p>}
          <h2>{section.title}</h2>
          <p>{section.summary}</p>
          {section.items && (
            <ul>
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  {pageKey === "solutions" && (
    <section class="section section--white">
      <div class="container">
        <div class="section-intro">
          <p>{page.eyebrow}</p>
          <h2>{pageLabels[locale].solutions.title}</h2>
        </div>
        <div class="grid grid--4 product-grid">
          {products.map((product) => (
            <ProductFamilyCard
              {...product}
              materialLabel={cardLabels.material}
              processLabel={cardLabels.process}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {pageKey === "knowledge" && (
    <section class="section section--white">
      <div class="container">
        <div class="section-intro">
          <p>blog.plachem.biz</p>
          <h2>{pageLabels[locale].knowledge.title}</h2>
        </div>
        <div class="grid grid--3">
          {blogs.map((blog) => <BlogCard {...blog} />)}
        </div>
      </div>
    </section>
  )}

  {pageKey === "contact" && (
    <section class="section section--white">
      <div class="container contact-grid">
        <article class="contact-card">
          <h2>{contactLabels.vietnam}</h2>
          <dl>
            <div>
              <dt>{contactLabels.address}</dt>
              <dd>{companyFacts.site}</dd>
            </div>
            <div>
              <dt>{contactLabels.phone}</dt>
              <dd><a href={`tel:${companyFacts.vietnamPhone}`}>{companyFacts.vietnamPhone}</a></dd>
            </div>
          </dl>
        </article>
        <article class="contact-card">
          <h2>{contactLabels.korea}</h2>
          <dl>
            <div>
              <dt>{contactLabels.address}</dt>
              <dd>{locale === "ko" ? companyFacts.koreaAddressKo : companyFacts.koreaAddressEn}</dd>
            </div>
            <div>
              <dt>{contactLabels.phone}</dt>
              <dd><a href={`tel:${companyFacts.koreaPhone}`}>{companyFacts.koreaPhone}</a></dd>
            </div>
          </dl>
        </article>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <CTAPanel title={pageLabels[locale].contact.title} summary={page.description} ctas={[
        { label: page.ctaLabel, href: page.ctaHref, variant: "primary" },
        {
          label: locale === "ko" ? "제품·솔루션" : locale === "en" ? "Products & Solutions" : "Sản phẩm & giải pháp",
          href: localizedPath(locale, "solutions"),
          variant: "secondary",
        },
      ]} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background:
      linear-gradient(135deg, rgba(11, 31, 58, 0.96), rgba(11, 31, 58, 0.88)),
      var(--color-navy);
    color: white;
    overflow: hidden;
    padding-block: var(--space-8);
  }

  .page-hero__grid {
    align-items: center;
    display: grid;
    gap: var(--space-6);
  }

  .eyebrow,
  .panel-eyebrow,
  .section-intro p {
    color: var(--color-blue);
    font-weight: 900;
    letter-spacing: 0;
    margin: 0 0 var(--space-2);
  }

  .page-hero .eyebrow {
    color: white;
  }

  h1 {
    font-size: clamp(2.5rem, 8vw, 5.25rem);
    line-height: 1.02;
    margin: 0;
    max-width: 11ch;
  }

  .lead {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    margin: var(--space-5) 0;
    max-width: 58ch;
  }

  .process-visual {
    background: rgba(248, 250, 252, 0.08);
    border: 1px solid rgba(248, 250, 252, 0.28);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-3);
    min-height: 260px;
    padding: var(--space-6);
    position: relative;
  }

  .process-visual span {
    background: white;
    border-radius: var(--radius-sm);
    display: block;
    height: 16px;
    opacity: 0.95;
  }

  .process-visual span:nth-child(2) {
    background: var(--color-blue);
    margin-left: 14%;
  }

  .process-visual span:nth-child(3) {
    margin-left: 28%;
  }

  .process-visual strong {
    align-self: end;
    font-size: clamp(1.4rem, 4vw, 2.25rem);
  }

  .content-grid {
    display: grid;
    gap: var(--space-4);
  }

  .info-panel,
  .contact-card {
    background: white;
    border: var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .info-panel:nth-child(1) {
    border-left: 6px solid var(--color-blue);
  }

  h2 {
    color: var(--color-navy);
    font-size: clamp(1.45rem, 3vw, 2.25rem);
    line-height: 1.15;
    margin: 0 0 var(--space-3);
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  li {
    border: var(--border);
    border-radius: var(--radius-sm);
    color: var(--color-navy);
    font-weight: 800;
    padding: var(--space-2) var(--space-3);
  }

  .section-intro {
    margin-bottom: var(--space-5);
    max-width: 720px;
  }

  .product-grid {
    margin-top: var(--space-5);
  }

  .contact-grid {
    display: grid;
    gap: var(--space-4);
  }

  dl {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  dt {
    color: var(--color-blue);
    font-weight: 900;
  }

  dd {
    margin: var(--space-1) 0 0;
  }

  @media (min-width: 48rem) {
    .content-grid,
    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .page-hero__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    }

    .content-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
