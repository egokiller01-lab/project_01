---
import BlogCard from "./BlogCard.astro";
import CTAPanel from "./CTAPanel.astro";
import InquiryForm from "./InquiryForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedPath } from "../data/navigation";
import {
  companyFacts,
  getStaticPage,
  pageLabels,
  verifiedBlogLinks,
  type StaticPageKey,
} from "../data/pages";
import { processLabels, productSlugs, products } from "../data/products";
import type { Locale } from "../types";

type Props = {
  locale: Locale;
  pageKey: StaticPageKey;
};

const { locale, pageKey } = Astro.props;
const page = getStaticPage(locale, pageKey);
const productDetails = products[locale];
const blogs = verifiedBlogLinks[locale];
const locales: Locale[] = ["ko", "en", "vi"];
const alternatePaths = Object.fromEntries(
  locales.map((targetLocale) => [
    targetLocale,
    localizedPath(targetLocale, pageKey),
  ]),
) as Record<Locale, string>;
const processMap = Object.fromEntries(
  productSlugs.map((slug) => [slug, processLabels[locale][slug]]),
);
const ui = {
  ko: {
    established: "설립",
    base: "Bắc Ninh 제조 기반",
    founded: "PLACHEM VINA 설립",
    processLabel: "적용 공정",
    scopeLabel: "취급 품목·공정",
    diagnosticTitle: "진단 프로세스",
    diagnosticLead:
      "문의 내용은 공정 정보부터 재확인 단계까지 순서대로 정리해 원인축을 좁힙니다.",
    analysisTitle: "분석 항목",
    analysisItems: "pH · 금속농도 · 온도 · 교반 · 여과",
    qualityNoteTitle: "기록과 추적",
    qualityNote:
      "원료 입고와 제조, 검사, 출하 확인 정보를 LOT 흐름으로 연결하고 요청 문서 제공 절차를 분리해 관리합니다.",
    docIndexTitle: "공정별 자료 분류",
    docItems: [
      "전처리",
      "도금",
      "무전해도금",
      "아노다이징",
      "화성피막",
      "품질문서",
    ],
    magazineTop: "TECHNICAL",
    magazineTitle: "DOCUMENTS",
    magazineNote: "공정관리 · 불량 원인 · 품질문서",
    contactAsideTitle: "기술지원 상담",
    contactAsideText: "제품군과 공정 조건을 기준으로 안내합니다.",
    processPrefix: "문의 분야: ",
    selectedText:
      "제품군, 현재 공정, 사용 중인 약품, 증상 또는 요청 자료를 기준으로 상담 범위를 확인할 수 있습니다.",
    supportSteps: [
      "공정 정보 확인",
      "도금욕 분석",
      "불량 원인 분류",
      "조건 조정",
      "재확인 및 안정화",
    ],
    qualitySteps: [
      "원료 입고 확인",
      "제조관리",
      "공정검사",
      "완제품검사",
      "출하 확인",
      "LOT 추적",
      "TDS·SDS·COA 제공",
    ],
    heroQualitySteps: ["원료", "제조", "검사", "출하", "LOT"],
  },
  en: {
    established: "Established",
    base: "Bắc Ninh manufacturing base",
    founded: "PLACHEM VINA established",
    processLabel: "Applied process",
    scopeLabel: "Handled items & processes",
    diagnosticTitle: "Diagnostic process",
    diagnosticLead:
      "Inquiry details are organized from process information through follow-up checks to narrow down possible cause groups.",
    analysisTitle: "Analysis items",
    analysisItems:
      "pH · Metal concentration · Temperature · Agitation · Filtration",
    qualityNoteTitle: "Records and traceability",
    qualityNote:
      "Raw material receiving, manufacturing, inspection, and shipment check records are connected with LOT flow, while document procedures are managed separately.",
    docIndexTitle: "Resources by process",
    docItems: [
      "Pretreatment",
      "Plating",
      "Electroless plating",
      "Anodizing",
      "Conversion coating",
      "Quality documents",
    ],
    magazineTop: "TECHNICAL",
    magazineTitle: "DOCUMENTS",
    magazineNote: "Process control · Defect causes · Quality documents",
    contactAsideTitle: "Technical consultation",
    contactAsideText:
      "Guidance is based on product group and process conditions.",
    processPrefix: "Inquiry area: ",
    selectedText:
      "Product group, current process, chemical in use, symptoms, or requested documents help define the consultation scope.",
    supportSteps: [
      "Process information check",
      "Plating bath analysis",
      "Defect cause classification",
      "Condition adjustment",
      "Follow-up and stabilization",
    ],
    qualitySteps: [
      "Raw material receiving check",
      "Manufacturing control",
      "In-process inspection",
      "Final inspection",
      "Shipment check",
      "LOT tracking",
      "TDS/SDS/COA provision",
    ],
    heroQualitySteps: [
      "Raw material",
      "Manufacturing",
      "Inspection",
      "Shipment",
      "LOT",
    ],
  },
  vi: {
    established: "Thành lập",
    base: "Cơ sở sản xuất Bắc Ninh",
    founded: "PLACHEM VINA thành lập",
    processLabel: "Công đoạn áp dụng",
    scopeLabel: "Hạng mục & công đoạn",
    diagnosticTitle: "Quy trình chẩn đoán",
    diagnosticLead:
      "Thông tin tư vấn được sắp xếp từ dữ liệu công đoạn đến bước kiểm tra lại để thu hẹp nhóm nguyên nhân.",
    analysisTitle: "Hạng mục phân tích",
    analysisItems: "pH · Nồng độ kim loại · Nhiệt độ · Khuấy · Lọc",
    qualityNoteTitle: "Hồ sơ và truy xuất",
    qualityNote:
      "Thông tin tiếp nhận nguyên liệu, sản xuất, kiểm tra và xuất hàng được kết nối theo dòng LOT, còn quy trình tài liệu được quản lý riêng.",
    docIndexTitle: "Tài liệu theo công đoạn",
    docItems: [
      "Tiền xử lý",
      "Mạ",
      "Mạ không điện",
      "Anod nhôm",
      "Lớp phủ chuyển hóa",
      "Tài liệu chất lượng",
    ],
    magazineTop: "TÀI LIỆU",
    magazineTitle: "KỸ THUẬT",
    magazineNote: "Quản lý công đoạn · Nguyên nhân lỗi · Tài liệu chất lượng",
    contactAsideTitle: "Tư vấn kỹ thuật",
    contactAsideText:
      "Hướng dẫn dựa trên nhóm sản phẩm và điều kiện công đoạn.",
    processPrefix: "Lĩnh vực tư vấn: ",
    selectedText:
      "Nhóm sản phẩm, công đoạn hiện tại, hóa chất đang sử dụng, triệu chứng hoặc tài liệu yêu cầu giúp xác định phạm vi tư vấn.",
    supportSteps: [
      "Kiểm tra thông tin công đoạn",
      "Phân tích bể mạ",
      "Phân loại nguyên nhân lỗi",
      "Điều chỉnh điều kiện",
      "Kiểm tra lại và ổn định",
    ],
    qualitySteps: [
      "Kiểm tra nhập nguyên liệu",
      "Quản lý sản xuất",
      "Kiểm tra trong công đoạn",
      "Kiểm tra thành phẩm",
      "Kiểm tra xuất hàng",
      "Truy xuất LOT",
      "Cung cấp TDS/SDS/COA",
    ],
    heroQualitySteps: [
      "Nguyên liệu",
      "Sản xuất",
      "Kiểm tra",
      "Xuất hàng",
      "LOT",
    ],
  },
}[locale];
const heroProductIndexes = productDetails.map((product, index) => ({
  number: String(index + 1).padStart(2, "0"),
  title: product.title,
}));
const contactLabels = {
  ko: {
    vietnam: "베트남 법인",
    korea: "한국 연락처",
    phone: "전화",
    manufacturingBase: "제조 기반",
    address: "주소",
  },
  en: {
    vietnam: "Vietnam office",
    korea: "Korea contact",
    phone: "Phone",
    manufacturingBase: "Manufacturing base",
    address: "Address",
  },
  vi: {
    vietnam: "Văn phòng Việt Nam",
    korea: "Liên hệ Hàn Quốc",
    phone: "Điện thoại",
    manufacturingBase: "Cơ sở sản xuất",
    address: "Địa chỉ",
  },
}[locale];
const manufacturingBaseValue =
  locale === "vi" ? companyFacts.regionVi : companyFacts.site;
const heroVisualAssets = {
  about: "/assets/manufacturing-concept.webp",
  solutions: "/assets/plachem-hero.webp",
  technology: "/assets/surface-treatment-concept.webp",
  quality: "/assets/plachem-quality.webp",
  knowledge: "/assets/rd-concept.webp",
  contact: "/assets/plachem-hero.webp",
} as const;
const storyVisualAssets = {
  about: "/assets/rd-concept.webp",
  solutions: "/assets/surface-treatment-concept.webp",
  technology: "/assets/rd-concept.webp",
  quality: "/assets/manufacturing-concept.webp",
  knowledge: "/assets/plachem-quality.webp",
  contact: "",
} as const;
const visualCopy = {
  ko: {
    label: "공정 이해를 위한 콘셉트 이미지",
    alt: {
      about: "표면처리 약품 제조 환경을 설명하는 콘셉트 이미지",
      solutions: "정밀 금속 부품의 표면 품질을 표현한 이미지",
      technology: "금속 부품의 표면처리 공정을 표현한 콘셉트 이미지",
      quality: "금속 시편 분석과 품질관리를 표현한 콘셉트 이미지",
      knowledge: "표면처리 연구와 분석을 표현한 콘셉트 이미지",
      contact: "",
    },
    detailTitle: "PLACHEM의 지원 범위",
  },
  en: {
    label: "Concept image for process illustration",
    alt: {
      about:
        "Concept image illustrating a surface treatment chemical manufacturing environment",
      solutions:
        "Image representing controlled surface quality of precision metal parts",
      technology:
        "Concept image illustrating a metal surface treatment process",
      quality:
        "Concept image illustrating metal sample analysis and quality control",
      knowledge:
        "Concept image illustrating surface treatment research and analysis",
      contact: "",
    },
    detailTitle: "PLACHEM support scope",
  },
  vi: {
    label: "Hình ảnh minh họa quy trình",
    alt: {
      about: "Hình ảnh minh họa môi trường sản xuất hóa chất xử lý bề mặt",
      solutions:
        "Hình ảnh thể hiện chất lượng bề mặt của chi tiết kim loại chính xác",
      technology: "Hình ảnh minh họa công đoạn xử lý bề mặt kim loại",
      quality: "Hình ảnh minh họa phân tích mẫu kim loại và quản lý chất lượng",
      knowledge: "Hình ảnh minh họa nghiên cứu và phân tích xử lý bề mặt",
      contact: "",
    },
    detailTitle: "Phạm vi hỗ trợ của PLACHEM",
  },
}[locale];
---

<BaseLayout
  locale={locale}
  title={page.seoTitle}
  description={page.description}
  pageKey={page.key}
  alternatePaths={alternatePaths}
>
  <section
    class={`sub-hero sub-hero--${pageKey}`}
    style={`--sub-hero-image: url('${heroVisualAssets[pageKey]}')`}
  >
    <div class="container sub-hero__inner">
      <div class="sub-hero__copy">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>{page.title}</h1>
        <p class="lead">{page.lead}</p>
      </div>
      {
        pageKey === "about" && (
          <div class="hero-aside hero-aside--year" aria-label={ui.established}>
            <span>2016</span>
            <strong>{ui.established}</strong>
            <p>{ui.base}</p>
          </div>
        )
      }
      {
        pageKey === "solutions" && (
          <div class="hero-aside hero-aside--index" aria-label={page.title}>
            {heroProductIndexes.map((item) => (
              <span>
                <b>{item.number}</b>
                {item.title}
              </span>
            ))}
          </div>
        )
      }
      {
        pageKey === "technology" && (
          <ol
            class="hero-aside hero-aside--steps"
            aria-label={ui.diagnosticTitle}
          >
            {ui.supportSteps.map((step, index) => (
              <li>
                <b>{String(index + 1).padStart(2, "0")}</b>
                {step}
              </li>
            ))}
          </ol>
        )
      }
      {
        pageKey === "quality" && (
          <ol class="hero-aside hero-aside--quality" aria-label={page.title}>
            {ui.heroQualitySteps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        )
      }
      {
        pageKey === "knowledge" && (
          <div class="hero-aside hero-aside--magazine" aria-label={page.title}>
            <span>{ui.magazineTop}</span>
            <strong>{ui.magazineTitle}</strong>
            <p>{ui.magazineNote}</p>
          </div>
        )
      }
      {
        pageKey === "contact" && (
          <div
            class="hero-aside hero-aside--contact"
            aria-label={contactLabels.phone}
          >
            <span>+84 222 395 2060</span>
            <strong>{ui.contactAsideTitle}</strong>
            <p>{ui.contactAsideText}</p>
          </div>
        )
      }
    </div>
  </section>

  {
    storyVisualAssets[pageKey] && (
      <section class="visual-story">
        <div class="container visual-story__grid">
          <figure>
            <img
              src={storyVisualAssets[pageKey]}
              alt={visualCopy.alt[pageKey]}
              width="1200"
              height="675"
              loading="eager"
            />
            <figcaption>{visualCopy.label}</figcaption>
          </figure>
          <div>
            <p>{page.eyebrow}</p>
            <h2>{page.title}</h2>
            <ul>
              {page.sections.slice(0, 4).map((section, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{section.title}</strong>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  {
    pageKey === "about" && (
      <section class="section about-layout">
        <div class="container about-grid">
          <div class="timeline">
            <span>2016</span>
            <strong>
              {locale === "ko"
                ? companyFacts.establishedKo
                : locale === "en"
                  ? companyFacts.establishedEn
                  : companyFacts.establishedVi}
            </strong>
            <p>{ui.founded}</p>
          </div>
          <div class="about-copy">
            {page.sections.map((section) => (
              <article>
                <h2>{section.title}</h2>
                <p>{section.summary}</p>
                {section.items && (
                  <ul>
                    {section.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    pageKey === "solutions" && (
      <section class="section section--white">
        <div class="container product-process">
          {productDetails.map((product, index) => (
            <article class="product-row" id={product.slug}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h2>{product.title}</h2>
                <p>{product.summary}</p>
              </div>
              <dl>
                <div>
                  <dt>{ui.processLabel}</dt>
                  <dd>{product.processes.join(" · ")}</dd>
                </div>
                <div>
                  <dt>{ui.scopeLabel}</dt>
                  <dd>{product.materials.join(" · ")}</dd>
                </div>
              </dl>
              <a href={`/${locale}/contact/?process=${product.slug}`}>
                {product.cta}
              </a>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    pageKey === "technology" && (
      <section class="section diagnostic-section">
        <div class="container diagnostic-grid">
          <div>
            <h2>{ui.diagnosticTitle}</h2>
            <p>{ui.diagnosticLead}</p>
          </div>
          <ol class="diagnostic-flow">
            {ui.supportSteps.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{step}</strong>
              </li>
            ))}
          </ol>
        </div>
        <div class="container analysis-band">
          <h2>{ui.analysisTitle}</h2>
          <p>{ui.analysisItems}</p>
        </div>
      </section>
    )
  }

  {
    pageKey === "quality" && (
      <section class="section section--white">
        <div class="container quality-map">
          <ol>
            {ui.qualitySteps.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{step}</strong>
              </li>
            ))}
          </ol>
          <div class="quality-note">
            <h2>{ui.qualityNoteTitle}</h2>
            <p>{ui.qualityNote}</p>
          </div>
        </div>
      </section>
    )
  }

  {
    pageKey === "knowledge" && (
      <section class="section knowledge-page">
        <div class="container knowledge-grid">
          <div class="doc-index">
            <h2>{ui.docIndexTitle}</h2>
            <ul>
              {ui.docItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="magazine-list">
            {blogs.map((blog) => (
              <BlogCard {...blog} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    pageKey === "contact" && (
      <>
        <section class="section section--white contact-page">
          <div class="container contact-layout">
            <article
              class="selected-process"
              data-process-map={JSON.stringify(processMap)}
              data-process-prefix={ui.processPrefix}
              hidden
            >
              <span data-selected-process />
              <p>{ui.selectedText}</p>
            </article>
            <article class="contact-card contact-card--vietnam">
              <span class="contact-card__index">01</span>
              <h2>{contactLabels.vietnam}</h2>
              <dl>
                <div>
                  <dt>{contactLabels.manufacturingBase}</dt>
                  <dd>{manufacturingBaseValue}</dd>
                </div>
                <div>
                  <dt>{contactLabels.phone}</dt>
                  <dd>
                    <a
                      href={`tel:${companyFacts.vietnamPhone.replaceAll(" ", "")}`}
                    >
                      {companyFacts.vietnamPhone}
                    </a>
                  </dd>
                </div>
              </dl>
            </article>
            <article class="contact-card contact-card--korea">
              <span class="contact-card__index">02</span>
              <h2>{contactLabels.korea}</h2>
              <dl>
                <div>
                  <dt>{contactLabels.address}</dt>
                  <dd>
                    {locale === "ko"
                      ? companyFacts.koreaAddressKo
                      : locale === "en"
                        ? companyFacts.koreaAddressEn
                        : companyFacts.koreaAddressVi}
                  </dd>
                </div>
                <div>
                  <dt>{contactLabels.phone}</dt>
                  <dd>
                    <a href={`tel:${companyFacts.koreaPhone}`}>
                      {companyFacts.koreaPhone}
                    </a>
                  </dd>
                </div>
              </dl>
            </article>
          </div>
        </section>
        <InquiryForm locale={locale} />
      </>
    )
  }

  {
    pageKey !== "about" && pageKey !== "solutions" && (
      <section class="section detail-section">
        <div class="container">
          <p class="detail-kicker">{visualCopy.detailTitle}</p>
          <div class="detail-grid">
            {page.sections.map((section, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h2>{section.title}</h2>
                <p>{section.summary}</p>
                {section.items && (
                  <ul>
                    {section.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section final-cta">
    <div class="container">
      <CTAPanel
        title={pageLabels[locale].contact.title}
        summary={page.description}
        ctas={[
          { label: page.ctaLabel, href: page.ctaHref, variant: "primary" },
          {
            label:
              pageKey === "contact"
                ? locale === "ko"
                  ? "기술지원 방식"
                  : locale === "en"
                    ? "How support works"
                    : "Quy trình hỗ trợ"
                : locale === "ko"
                  ? "제품·솔루션"
                  : locale === "en"
                    ? "Products & Solutions"
                    : "Sản phẩm & giải pháp",
            href: localizedPath(
              locale,
              pageKey === "contact" ? "technology" : "solutions",
            ),
            variant: "secondary",
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const selected = document.querySelector("[data-selected-process]");
  const source = document.querySelector("[data-process-map]");

  if (selected && source) {
    const params = new URLSearchParams(window.location.search);
    const process = params.get("process") || "";
    const map = JSON.parse(source.getAttribute("data-process-map") || "{}");
    const prefix = source.getAttribute("data-process-prefix") || "";

    if (map[process]) {
      selected.textContent = prefix + map[process];
      source.removeAttribute("hidden");
    }
  }
</script>

<style>
  .visual-story {
    background: var(--color-navy);
    color: white;
    padding-block: clamp(2.4rem, 5vw, 4.4rem);
  }

  .visual-story__grid {
    align-items: stretch;
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .visual-story figure {
    margin: 0;
    min-height: 320px;
    overflow: hidden;
    position: relative;
  }

  .visual-story img {
    display: block;
    height: 100%;
    object-fit: cover;
