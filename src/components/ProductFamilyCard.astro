---
import type { ProductFamily } from "../types";

type Props = ProductFamily & {
  materialLabel?: string;
  processLabel?: string;
  index?: number;
};
const {
  title,
  summary,
  href,
  materials,
  process,
  cta,
  materialLabel = "Material",
  processLabel = "Process",
  index = 0,
} = Astro.props;
---

<article class="product-card" style={`--card-accent-index: ${index % 4};`}>
  <span class="product-mark" aria-hidden="true"
    >{String(index + 1).padStart(2, "0")}</span
  >
  <div>
    <h3><a href={href}>{title}</a></h3>
    <p>{summary}</p>
  </div>
  <dl>
    <div>
      <dt>{materialLabel}</dt>
      <dd>{materials}</dd>
    </div>
    <div>
      <dt>{processLabel}</dt>
      <dd>{process}</dd>
    </div>
  </dl>
  <a class="button button--ghost" href={href}>{cta}</a>
</article>

<style>
  .product-card {
    background: white;
    border: 1px solid rgba(192, 199, 209, 0.82);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-4);
    min-height: 100%;
    padding: var(--space-5);
    position: relative;
    overflow: hidden;
  }

  .product-card::before {
    background: linear-gradient(180deg, var(--color-blue), var(--color-navy));
    content: "";
    height: 100%;
    left: 0;
    opacity: calc(0.5 + (var(--card-accent-index) * 0.08));
    position: absolute;
    top: 0;
    width: 0.32rem;
  }

  .product-mark {
    align-items: center;
    background: var(--color-light);
    border: 1px solid rgba(192, 199, 209, 0.82);
    border-radius: var(--radius-sm);
    color: var(--color-blue);
    display: inline-flex;
    font-size: 0.74rem;
    font-weight: 900;
    height: 2rem;
    justify-content: center;
    width: 2.4rem;
  }

  h3 {
    margin: 0 0 var(--space-2);
  }

  h3 a {
    color: var(--color-navy);
    text-decoration: none;
  }

  p {
    color: rgba(17, 24, 39, 0.82);
    font-size: 0.94rem;
    margin: 0;
  }

  dl {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  dt {
    color: var(--color-blue);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  dd {
    font-size: 0.92rem;
    margin: 0;
  }

  .button {
    align-self: end;
    justify-self: start;
  }

  @media (max-width: 47.99rem) {
    .product-card {
      gap: var(--space-3);
      padding: var(--space-4);
    }

    dl {
      display: none;
    }

    .button {
      min-height: 40px;
      padding-inline: 0.75rem;
    }
  }
</style>
