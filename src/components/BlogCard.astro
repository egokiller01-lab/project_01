---
import type { BlogLink } from "../types";

type Props = BlogLink & {
  featured?: boolean;
  image?: string;
  imageAlt?: string;
  liveIndex?: number;
};

const {
  title,
  href,
  meta,
  summary,
  date,
  cta,
  featured = false,
  image,
  imageAlt = "",
  liveIndex,
} = Astro.props;
---

<article
  class:list={["blog-card", { "blog-card--featured": featured }]}
  data-blog-card={liveIndex}
>
  {
    image && (
      <a
        class="blog-card__image"
        data-blog-link
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
      >
        <img
          src={image}
          alt={imageAlt}
          width="1024"
          height="1024"
          loading="lazy"
          data-blog-image
        />
      </a>
    )
  }
  <div class="blog-card__body">
    <div class="blog-card__meta">
      <span data-blog-meta>{meta}</span>
      <time data-blog-date>{date}</time>
    </div>
    <h3>
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        data-blog-link
        data-blog-title
      >{title}</a>
    </h3>
    <p data-blog-summary>{summary}</p>
    <a
      class="blog-card__cta"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      data-blog-link
    >
      {cta}<span aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  .blog-card {
    background: white;
    border: 1px solid #d2deeb;
    border-radius: 0.85rem;
    display: grid;
    overflow: hidden;
    position: relative;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .blog-card::before {
    background: #1c72d6;
    content: "";
    height: 3px;
    left: 0;
    position: absolute;
    top: 0;
    width: 3.8rem;
    z-index: 2;
  }

  .blog-card:hover {
    border-color: #8eb7e2;
    box-shadow: 0 1.1rem 2.4rem rgba(11, 31, 58, 0.13);
    transform: translateY(-3px);
  }

  .blog-card__image {
    aspect-ratio: 16 / 7;
    display: block;
    overflow: hidden;
  }

  .blog-card__image img {
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
    width: 100%;
  }

  .blog-card:hover .blog-card__image img {
    transform: scale(1.035);
  }

  .blog-card__body {
    display: grid;
    gap: 0.8rem;
    padding: var(--space-5);
  }

  .blog-card__meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
  }

  .blog-card__meta span {
    color: var(--color-blue);
    font-size: 0.78rem;
    font-weight: 800;
  }

  time {
    color: #8290a0;
    font-size: 0.72rem;
    font-weight: 700;
  }

  h3 {
    color: var(--color-navy);
    font-size: 1.08rem;
    line-height: 1.45;
    margin: 0;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  p {
    color: #637184;
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
  }

  .blog-card__cta {
    align-items: center;
    color: var(--color-navy);
    display: inline-flex;
    font-size: 0.82rem;
    font-weight: 900;
    gap: 0.45rem;
    margin-top: 0.25rem;
    text-decoration: none;
    width: fit-content;
  }

  .blog-card__cta span {
    color: #1c72d6;
  }

  .blog-card--featured {
    background:
      linear-gradient(145deg, rgba(28, 114, 214, 0.18), transparent 48%),
      #0b1f3a;
    border-color: #244467;
    color: white;
    min-height: 100%;
  }

  .blog-card--featured::before {
    background: #69adff;
    height: 4px;
    width: 6rem;
  }

  .blog-card--featured .blog-card__image {
    aspect-ratio: 16 / 8;
    min-height: 230px;
    position: relative;
  }

  .blog-card--featured .blog-card__image::after {
    background: linear-gradient(180deg, transparent, rgba(11, 31, 58, 0.72));
    content: "";
    inset: 0;
    position: absolute;
  }

  .blog-card--featured .blog-card__body {
    padding: clamp(1.8rem, 4vw, 3.2rem);
  }

  .blog-card--featured h3 {
    color: white;
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    line-height: 1.23;
    max-width: 20ch;
  }

  .blog-card--featured p {
    color: #c2d1e2;
    font-size: 1rem;
    max-width: 42rem;
  }

  .blog-card--featured time {
    color: #92a8bf;
  }

  .blog-card--featured .blog-card__cta {
    color: white;
    margin-top: auto;
    padding-top: 1rem;
  }
</style>
