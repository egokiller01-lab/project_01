---
import { navigation } from "../data/navigation";
import type { Locale } from "../types";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const footerNavLabel = {
  ko: "하단 메뉴",
  en: "Footer navigation",
  vi: "Điều hướng cuối trang",
}[locale];
const copy = {
  ko: {
    tagline: "Precision Surface Treatment Chemical Solutions",
    description:
      "한국 포뮬레이션 기술과 베트남 현지 제조, 공정 조건 중심의 기술지원으로 생산현장의 안정화를 돕습니다.",
    profile: "회사 정보",
    links: "바로가기",
    inquiry: "기술문의",
    facts: ["설립 2016.04.13", "베트남 박닌", "표면처리약품 제조·유통"],
    inquiryText:
      "소재, 공정, 현재 증상과 요청사항을 알려주시면 확인 범위를 정리해 드립니다.",
    inquiryCta: "문의 내용 작성하기",
    rights: "PLACHEM VINA CO., LTD. All rights reserved.",
  },
  en: {
    tagline: "Precision Surface Treatment Chemical Solutions",
    description:
      "Korean formulation expertise, Vietnam-based manufacturing, and process-focused technical support help stabilize production lines.",
    profile: "Company",
    links: "Quick links",
    inquiry: "Technical inquiry",
    facts: [
      "Established 13 Apr 2016",
      "Bac Ninh, Vietnam",
      "Surface-treatment chemicals",
    ],
    inquiryText:
      "Share the substrate, process, current symptoms, and request so we can organize the review scope.",
    inquiryCta: "Prepare an inquiry",
    rights: "PLACHEM VINA CO., LTD. All rights reserved.",
  },
  vi: {
    tagline: "Precision Surface Treatment Chemical Solutions",
    description:
      "Chuyên môn công thức Hàn Quốc, sản xuất tại Việt Nam và hỗ trợ theo điều kiện công đoạn giúp ổn định dây chuyền sản xuất.",
    profile: "Thông tin công ty",
    links: "Liên kết nhanh",
    inquiry: "Liên hệ kỹ thuật",
    facts: [
      "Thành lập 13.04.2016",
      "Bắc Ninh, Việt Nam",
      "Hóa chất xử lý bề mặt",
    ],
    inquiryText:
      "Hãy cung cấp vật liệu, công đoạn, triệu chứng hiện tại và yêu cầu để chúng tôi sắp xếp phạm vi xem xét.",
    inquiryCta: "Chuẩn bị nội dung liên hệ",
    rights: "PLACHEM VINA CO., LTD. All rights reserved.",
  },
}[locale];
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href={`/${locale}/`} aria-label="PLACHEM VINA">
        <strong>PLACHEM</strong><span>VINA CO., LTD.</span>
      </a>
      <p class="tagline">{copy.tagline}</p>
      <p>{copy.description}</p>
    </div>
    <div class="footer-profile">
      <h2>{copy.profile}</h2>
      <ul>{copy.facts.map((fact) => <li>{fact}</li>)}</ul>
    </div>
    <nav aria-label={footerNavLabel}>
      <h2>{copy.links}</h2>
      {navigation[locale].map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="footer-inquiry">
      <h2>{copy.inquiry}</h2>
      <p>{copy.inquiryText}</p>
      <a href={`/${locale}/contact/`}>{copy.inquiryCta}<span>→</span></a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>PLACHEM VINA · BAC NINH · VIETNAM</span>
    <span>© {new Date().getFullYear()} {copy.rights}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: #07172d;
    color: #aebdce;
    padding-block: clamp(3.5rem, 6vw, 5.5rem) 1.5rem;
  }
  .footer-main {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
  }
  .footer-brand > a {
    color: white;
    display: grid;
    line-height: 1;
    text-decoration: none;
  }
  .footer-brand strong {
    font-size: 1.55rem;
    letter-spacing: 0.035em;
  }
  .footer-brand > a span {
    color: #7f96af;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    margin-top: 0.35rem;
  }
  .footer-brand p,
  .footer-inquiry p {
    line-height: 1.75;
    margin: 1rem 0 0;
    max-width: 32rem;
  }
  .footer-brand .tagline {
    color: #6db0ff;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    margin-top: 1.5rem;
    text-transform: uppercase;
  }
  h2 {
    color: white;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    margin: 0 0 1.1rem;
    text-transform: uppercase;
  }
  .footer-profile ul {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-profile li {
    font-size: 0.88rem;
  }
  nav {
    align-content: start;
    display: grid;
    gap: 0.55rem;
  }
  nav a {
    font-size: 0.9rem;
    text-decoration: none;
  }
  nav a:hover {
    color: white;
  }
  .footer-inquiry > a {
    align-items: center;
    border-bottom: 1px solid #49617c;
    color: white;
    display: flex;
    font-weight: 800;
    justify-content: space-between;
    margin-top: 1.5rem;
    padding-bottom: 0.85rem;
    text-decoration: none;
  }
  .footer-inquiry > a span {
    color: #6db0ff;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.67rem;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    letter-spacing: 0.04em;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.25rem;
  }
  @media (min-width: 48rem) {
    .footer-main {
      grid-template-columns: minmax(0, 1.35fr) minmax(10rem, 0.65fr) minmax(
          9rem,
          0.55fr
        );
    }
    .footer-inquiry {
      grid-column: 2 / 4;
    }
  }
  @media (min-width: 64rem) {
    .footer-main {
      grid-template-columns: minmax(0, 1.4fr) minmax(10rem, 0.7fr) minmax(
          9rem,
          0.55fr
        ) minmax(0, 1fr);
    }
    .footer-inquiry {
      grid-column: auto;
    }
  }
</style>
