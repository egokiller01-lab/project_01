                </>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section knowledge-section">
    <div class="container knowledge-layout">
      <div class="knowledge-intro">
        <p class="kicker">{ui.knowledgeKicker}</p><h2>{ui.knowledgeTitle}</h2><p
