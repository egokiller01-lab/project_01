      </div>
      <div class="blog-list">
        {content.blogs.map((blog) => <BlogCard {...blog} />)}
      </div>
    </div>
  </section>

  <section class="section final-section">
    <div class="container">
      <CTAPanel
        title={ui.ctaTitle}
        summary={ui.ctaSummary}
        ctas={content.primaryCtas}
      />
    </div>
  </section>
</BaseLayout>

