        <figure>
          <img
            src="/assets/surface-treatment-concept.webp"
            alt={ui.processImageAlt}
            width="1024"
            height="1024"
            loading="lazy"
          /><figcaption>{ui.conceptNote}</figcaption>
        </figure>
        <div class="focus-list">
          {
            ui.focusItems.map((item, index) => (
              <article>
                <>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <>
                      <h3>{item.title}</h3>
                      <p>{item.body}</p>
                      <ul>
                        {item.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section defect-section">
    <div class="container defect-layout">
      <div class="defect-copy">
        <p class="kicker">{ui.supportKicker}</p><h2>{ui.supportTitle}</h2><p>
          {ui.supportLead}
