          >{ui.supportCta}<span aria-hidden="true">→</span></a>
      </div>
      <div class="defect-grid">
        {
          ui.defects.map(([name, causes], index) => (
            <article>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{name}</h3>
                <p>{causes}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section capability-section">
    <div class="container">
      <header class="section-head">
        <div>
          <p class="kicker">{ui.capabilityKicker}</p><h2>
            {ui.capabilityTitle}
          </h2>
