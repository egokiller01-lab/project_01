const blogHome = locale === "vi" ? "https://blog.plachem.biz/vi/" : "https://blog.plachem.biz/";
const blogTopics = {
  ko: [
    ["표면처리 전체", "https://blog.plachem.biz/category/%ED%91%9C%EB%A9%B4%EC%B2%98%EB%A6%AC-%EC%9E%90%EB%A3%8C%EC%8B%A4/"],
    ["전기도금", "https://blog.plachem.biz/category/%ED%91%9C%EB%A9%B4%EC%B2%98%EB%A6%AC-%EC%9E%90%EB%A3%8C%EC%8B%A4/%EC%A0%84%EA%B8%B0%EB%8F%84%EA%B8%88/"],
    ["화학도금", "https://blog.plachem.biz/category/%ED%91%9C%EB%A9%B4%EC%B2%98%EB%A6%AC-%EC%9E%90%EB%A3%8C%EC%8B%A4/chemical-plating-ko/"],
    ["아노다이징", "https://blog.plachem.biz/category/%ED%91%9C%EB%A9%B4%EC%B2%98%EB%A6%AC-%EC%9E%90%EB%A3%8C%EC%8B%A4/%EC%95%84%EB%85%B8%EB%8B%A4%EC%9D%B4%EC%A7%95/"],
  ],
  en: [
    ["All resources", "https://blog.plachem.biz/"],
    ["Electroplating", "https://blog.plachem.biz/category/%ED%91%9C%EB%A9%B4%EC%B2%98%EB%A6%AC-%EC%9E%90%EB%A3%8C%EC%8B%A4/%EC%A0%84%EA%B8%B0%EB%8F%84%EA%B8%88/"],
    ["Chemical plating", "https://blog.plachem.biz/category/%ED%91%9C%EB%A9%B4%EC%B2%98%EB%A6%AC-%EC%9E%90%EB%A3%8C%EC%8B%A4/chemical-plating-ko/"],
    ["Anodizing", "https://blog.plachem.biz/category/%ED%91%9C%EB%A9%B4%EC%B2%98%EB%A6%AC-%EC%9E%90%EB%A3%8C%EC%8B%A4/%EC%95%84%EB%85%B8%EB%8B%A4%EC%9D%B4%EC%A7%95/"],
  ],
  vi: [
    ["Tất cả tài liệu", "https://blog.plachem.biz/vi/category/surface-treatment-vi/"],
    ["Mạ điện", "https://blog.plachem.biz/vi/category/surface-treatment-vi/electroplating-vi/"],
    ["Mạ hóa học", "https://blog.plachem.biz/vi/category/surface-treatment-vi/chemical-plating-vi/"],
    ["Anodizing nhôm", "https://blog.plachem.biz/vi/category/surface-treatment-vi/anodizing-vi/"],
  ],
}[locale];
---

<BaseLayout
  locale={locale}
  title={content.seoTitle}
  description={content.description}
  pageKey="home"
>
  <Hero
    eyebrow={content.heroEyebrow}
    titleLines={content.heroTitleLines}
    accent={content.heroAccent}
    summary={content.heroSummary}
    ctas={content.primaryCtas}
    strengths={content.strengths}
    visualLabel={ui.heroVisual}
    metricsLabel={ui.summary}
    imageSrc="/assets/plachem-hero.webp"
    imageAlt={ui.heroAlt}
  />

  <section class="section decade-section">
    <div class="container media-split">
      <figure class="editorial-image">
        <img
          src="/assets/manufacturing-concept.webp"
          alt={ui.decadeImageAlt}
          width="1024"
          height="1024"
          loading="lazy"
        />
        <figcaption>{ui.conceptNote}</figcaption>
      </figure>
      <div class="editorial-copy">
        <p class="kicker">{ui.decadeKicker}</p>
        <h2>{ui.decadeTitle}</h2>
        <p class="lead">{ui.decadeLead}</p>
        <ul class="fact-grid">
          {
            ui.decadeFacts.map((item, index) => (
              <li>
                <>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <strong>{item.value}</strong>
                    <small>{item.label}</small>
                  </div>
                </>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section solutions-section">
    <div class="container">
      <header class="section-head">
        <div>
          <p class="kicker">{ui.solutionKicker}</p><h2>{ui.solutionTitle}</h2>
        </div><p>{ui.solutionLead}</p>
      </header>
      <div class="solution-grid">
        {
          productDetails.map((product, index) => (
            <a
              href={`/${locale}/solutions/#${product.slug}`}
              class="solution-card"
            >
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{product.title}</h3>
                <p>{product.summary}</p>
                <small>{product.materials.slice(0, 5).join(" · ")}</small>
                <b aria-hidden="true">↗</b>
              </>
            </a>
          ))
        }
      </div>
      <a class="text-link" href={`/${locale}/solutions/`}
        >{ui.explore}<span aria-hidden="true">→</span></a
      >
    </div>
  </section>

  <section class="section focus-section">
    <div class="container">
      <header class="section-head section-head--light">
        <div>
          <p class="kicker">{ui.focusKicker}</p><h2>{ui.focusTitle}</h2>
        </div><p>{ui.focusLead}</p>
      </header>
      <div class="focus-layout">
        <figure>
          <img
            src="/assets/surface-treatment-concept.webp"
            alt={ui.processImageAlt}
            width="1024"
            height="1024"
            loading="lazy"
          /><figcaption>{ui.conceptNote}</figcaption>
        </figure>
        <div class="focus-list">
          {
            ui.focusItems.map((item, index) => (
              <article>
                <>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <>
                      <h3>{item.title}</h3>
                      <p>{item.body}</p>
                      <ul>
                        {item.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section defect-section">
    <div class="container defect-layout">
      <div class="defect-copy">
        <p class="kicker">{ui.supportKicker}</p><h2>{ui.supportTitle}</h2><p>
          {ui.supportLead}
        </p><a class="text-link" href={`/${locale}/technology/`}
          >{ui.supportCta}<span aria-hidden="true">→</span></a
        >
      </div>
      <div class="defect-grid">
        {
          ui.defects.map(([name, causes], index) => (
            <article>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{name}</h3>
                <p>{causes}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section support-model-section">
    <div class="container">
      <header class="section-head">
        <div>
          <p class="kicker">{ui.supportModelKicker}</p>
          <h2>{ui.supportModelTitle}</h2>
        </div>
        <p>{ui.supportModelLead}</p>
      </header>
      <ol class="support-model-grid">
        {
          ui.supportModelSteps.map((step, index) => (
            <li>
              <div class="step-heading">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span aria-hidden="true">→</span>
              </div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              <small>{step.meta}</small>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section capability-section">
    <div class="container">
      <header class="section-head">
        <div>
          <p class="kicker">{ui.capabilityKicker}</p><h2>
            {ui.capabilityTitle}
          </h2>
        </div><p>{ui.capabilityLead}</p>
      </header>
      <div class="capability-grid">
        {
          ui.capabilities.map((item) => (
            <article>
              <>
                <figure>
                  <>
                    <img
                      src={item.image}
                      alt={item.alt}
                      width="1024"
                      height="1024"
                      loading="lazy"
                    />
                    <figcaption>{ui.conceptNote}</figcaption>
                  </>
                </figure>
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
      <div class="quality-flow">
        <p class="kicker">{ui.qualityKicker}</p><ol>
          {
            content.qualitySteps.map((step, index) => (
              <li>
                <>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{step}</strong>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section application-section">
    <div class="container">
      <header class="section-head">
        <div>
          <p class="kicker">{ui.applicationKicker}</p>
          <h2>{ui.applicationTitle}</h2>
        </div>
        <p>{ui.applicationLead}</p>
      </header>
      <div class="application-grid">
        {
          ui.applications.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <ul>
                {item.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section knowledge-section" id="technical-blog">
    <div class="container">
      <div class="knowledge-heading">
        <div class="knowledge-intro">
          <p class="kicker">{ui.knowledgeKicker}</p>
          <h2>{ui.knowledgeTitle}</h2>
          <p>{ui.knowledgeLead}</p>
        </div>
        <aside class="blog-brand" aria-label={ui.blogBrand}>
          <span>{ui.blogNote}</span>
          <strong>{ui.blogBrand}</strong>
          <small>{ui.blogAddress}</small>
          <a href={blogHome} target="_blank" rel="noopener noreferrer">
            {ui.visitBlog}<span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>

      <nav class="blog-topics" aria-label={ui.blogBrand}>
        {blogTopics.map(([label, href]) => (
          <a href={href} target="_blank" rel="noopener noreferrer">
            {label}<span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>

      <div class="blog-editorial-grid">
        <div class="featured-blog">
          <p class="blog-list-label">{ui.featuredArticle}</p>
          <BlogCard {...content.blogs[0]} featured />
        </div>
        <div class="blog-list">
          <p class="blog-list-label">{ui.latestArticles}</p>
          {content.blogs.slice(1).map((blog) => <BlogCard {...blog} />)}
        </div>
      </div>

      <div class="knowledge-footer">
        <p>{ui.knowledgeTopics.join(" · ")}</p>
        <a class="text-link" href={`/${locale}/knowledge/`}>
          {ui.moreKnowledge}<span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section final-section">
    <div class="container">
      <CTAPanel
        title={ui.ctaTitle}
        summary={ui.ctaSummary}
        ctas={content.primaryCtas}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: clamp(4rem, 7vw, 6.5rem);
  }
  .kicker {
    color: #1c72d6;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    margin: 0 0 1rem;
  }
  h2 {
    color: var(--color-navy);
    font-size: clamp(2.1rem, 4.2vw, 3.6rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0;
  }
  h3,
  p {
    margin: 0;
  }
  .lead {
    color: #526173;
    font-size: 1.08rem;
    line-height: 1.85;
    margin-top: var(--space-5);
  }
  .media-split,
  .section-head,
  .focus-layout,
  .defect-layout,
  .knowledge-heading,
  .blog-editorial-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .editorial-image,
  .focus-layout figure,
  .capability-grid figure {
    margin: 0;
    overflow: hidden;
    position: relative;
  }
  .editorial-image img,
  .focus-layout img,
  .capability-grid img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  .editorial-image {
    min-height: 420px;
  }
  figure figcaption {
    background: rgba(11, 31, 58, 0.86);
    bottom: 0;
    color: white;
    font-size: 0.7rem;
    left: 0;
    letter-spacing: 0.04em;
    padding: 0.45rem 0.7rem;
    position: absolute;
  }
  .editorial-copy {
    align-self: center;
  }
  .fact-grid {
    display: grid;
    gap: 0;
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
  }
  .fact-grid li {
    align-items: center;
    border-top: var(--border);
    display: grid;
    gap: 1rem;
    grid-template-columns: 2.8rem 1fr;
    min-height: 64px;
