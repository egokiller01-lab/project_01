---
type Props = {
  steps: string[];
};

const { steps } = Astro.props;
---

<ol class="process-diagram" aria-label="Process flow">
  {steps.map((step) => <li>{step}</li>)}
</ol>

<style>
  .process-diagram {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    background: white;
    border: var(--border);
    border-left: 4px solid var(--color-blue);
    border-radius: var(--radius-md);
    color: var(--color-navy);
    font-weight: 800;
    padding: var(--space-4);
  }

  @media (min-width: 48rem) {
    .process-diagram {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
