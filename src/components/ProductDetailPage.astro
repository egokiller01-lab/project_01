---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTAPanel from "./CTAPanel.astro";
import { products, type ProductSlug } from "../data/products";
import type { Locale } from "../types";

type Props = {
  locale: Locale;
  slug: ProductSlug;
};

const { locale, slug } = Astro.props;
const product = products[locale].find((item) => item.slug === slug);

if (!product) {
  throw new Error(`Unknown product slug: ${slug}`);
}

const locales: Locale[] = ["ko", "en", "vi"];
const alternatePaths = Object.fromEntries(
  locales.map((targetLocale) => [
    targetLocale,
    `/${targetLocale}/products/${slug}/`,
  ]),
) as Record<Locale, string>;

const productVisuals: Record<ProductSlug, string> = {
  pretreatment: "/assets/product-pretreatment-v1.webp",
  electroplating: "/assets/product-electroplating-v1.webp",
  "electroless-plating": "/assets/product-electroless-v1.webp",
  "aluminum-anodizing": "/assets/product-anodizing-v1.webp",
  "conversion-coating": "/assets/product-conversion-v1.webp",
  "post-treatment-specialty": "/assets/product-post-treatment-v1.webp",
  "basic-chemicals": "/assets/product-basic-chemicals-v1.webp",
  "filtration-equipment": "/assets/product-filtration-v1.webp",
};

const currentIndex = products[locale].findIndex((item) => item.slug === slug);
const solutionProducts = products[locale];

const copy = {
  ko: {
    eyebrow: "제품·솔루션",
    allProducts: "전체 제품군",
    inquiry: "이 제품군 문의",
    overviewKicker: "PROCESS OVERVIEW",
    overviewTitle: "공정 조건에서 시작하는 제품 검토",
    overviewLead:
      "제품명만으로 적용 여부를 정하지 않고 소재, 전후 공정, 관리항목, 요구 품질을 함께 확인합니다.",
    handled: "적용 소재·대상",
    processScope: "적용 공정 범위",
    checksKicker: "CONTROL POINTS",
    checksTitle: "적용 전 확인할 주요 관리항목",
    checksLead:
      "현재 설정값과 최근 변경 이력을 함께 알려주면 확인 순서를 더 정확히 정리할 수 있습니다.",
    issuesKicker: "TROUBLESHOOTING",
    issuesTitle: "대표 문제와 우선 점검 방향",
    issuesLead:
      "한 가지 증상에도 여러 공정 요인이 연결될 수 있으므로 원인 후보와 확인 순서를 함께 봅니다.",
    causes: "가능 원인",
    action: "우선 점검",
    supportKicker: "TECHNICAL SUPPORT",
    supportTitle: "PLACHEM 기술지원 범위",
    supportLead:
      "문의 시 현장 조건과 불량 증상을 기준으로 우선 확인할 항목을 정리합니다.",
    relatedKicker: "RELATED SOLUTIONS",
    relatedTitle: "전체 제품군 살펴보기",
    viewDetails: "상세보기",
    currentProduct: "현재 제품군",
    concept: "공정 이해를 위한 콘셉트 이미지",
    ctaTitle: `${product.title} 적용 조건을 상담하세요`,
    ctaSummary:
      "소재, 현재 공정 순서, 사용 중인 약품, 관리값, 불량 증상 또는 요청 자료를 알려주십시오.",
    imageAlt: `${product.title} 공정을 설명하는 콘셉트 이미지`,
  },
  en: {
    eyebrow: "Products & Solutions",
    allProducts: "All product groups",
    inquiry: "Inquire about this group",
    overviewKicker: "PROCESS OVERVIEW",
    overviewTitle: "Product review starts with process conditions",
    overviewLead:
      "Suitability is reviewed with the substrate, upstream and downstream stages, control items, and required finish—not by product name alone.",
    handled: "Applicable substrates & targets",
    processScope: "Application scope",
    checksKicker: "CONTROL POINTS",
    checksTitle: "Key control items to review before application",
    checksLead:
      "Current settings and recent changes help establish a more useful inspection sequence.",
    issuesKicker: "TROUBLESHOOTING",
    issuesTitle: "Common issues and first checks",
    issuesLead:
      "One symptom can involve several process factors, so likely causes and the inspection sequence are reviewed together.",
    causes: "Likely causes",
    action: "First checks",
    supportKicker: "TECHNICAL SUPPORT",
    supportTitle: "PLACHEM support scope",
    supportLead:
      "Field conditions and defect symptoms are used to organize the items that should be checked first.",
    relatedKicker: "RELATED SOLUTIONS",
    relatedTitle: "Explore all product groups",
    viewDetails: "View details",
    currentProduct: "Current product group",
    concept: "Concept image for process illustration",
    ctaTitle: `Discuss application conditions for ${product.title}`,
    ctaSummary:
      "Share the substrate, process sequence, chemicals in use, control values, defect symptoms, or required documents.",
    imageAlt: `Concept image illustrating the ${product.title} process`,
  },
  vi: {
    eyebrow: "Sản phẩm & giải pháp",
    allProducts: "Tất cả nhóm sản phẩm",
    inquiry: "Tư vấn nhóm sản phẩm này",
    overviewKicker: "TỔNG QUAN CÔNG ĐOẠN",
    overviewTitle: "Xem xét sản phẩm bắt đầu từ điều kiện công đoạn",
    overviewLead:
      "Khả năng áp dụng được xem xét cùng vật liệu, công đoạn trước và sau, hạng mục quản lý và yêu cầu bề mặt, không chỉ dựa trên tên sản phẩm.",
    handled: "Vật liệu & đối tượng áp dụng",
    processScope: "Phạm vi áp dụng",
    checksKicker: "ĐIỂM KIỂM SOÁT",
    checksTitle: "Hạng mục quản lý chính cần kiểm tra trước khi áp dụng",
    checksLead:
      "Giá trị cài đặt hiện tại và các thay đổi gần đây giúp sắp xếp thứ tự kiểm tra chính xác hơn.",
    issuesKicker: "XỬ LÝ SỰ CỐ",
    issuesTitle: "Vấn đề thường gặp và hướng kiểm tra đầu tiên",
    issuesLead:
      "Một triệu chứng có thể liên quan đến nhiều yếu tố, vì vậy cần xem xét cùng nguyên nhân và thứ tự kiểm tra.",
    causes: "Nguyên nhân có thể",
    action: "Kiểm tra trước",
    supportKicker: "HỖ TRỢ KỸ THUẬT",
    supportTitle: "Phạm vi hỗ trợ của PLACHEM",
    supportLead:
      "Điều kiện hiện trường và triệu chứng lỗi được dùng để sắp xếp các hạng mục cần kiểm tra trước.",
    relatedKicker: "GIẢI PHÁP LIÊN QUAN",
    relatedTitle: "Xem tất cả nhóm sản phẩm",
    viewDetails: "Xem chi tiết",
    currentProduct: "Nhóm sản phẩm hiện tại",
    concept: "Hình ảnh minh họa quy trình",
    ctaTitle: `Tư vấn điều kiện áp dụng cho ${product.title}`,
    ctaSummary:
      "Hãy cung cấp vật liệu, trình tự công đoạn, hóa chất đang sử dụng, giá trị quản lý, triệu chứng lỗi hoặc tài liệu cần thiết.",
    imageAlt: `Hình ảnh minh họa công đoạn ${product.title}`,
  },
}[locale];
---

<BaseLayout
  locale={locale}
  title={`${product.title} | PLACHEM VINA`}
  description={product.summary}
  pageKey="solutions"
  alternatePaths={alternatePaths}
>
  <section
    class="product-hero"
    style={`--product-image: url('${productVisuals[slug]}')`}
  >
    <div class="container product-hero__inner">
      <div class="product-hero__copy">
        <a class="breadcrumb" href={`/${locale}/solutions/`}
          >← {copy.allProducts}</a
        >
        <p class="eyebrow">
          {copy.eyebrow} · {String(currentIndex + 1).padStart(2, "0")}
        </p>
        <h1>{product.title}</h1>
        <p class="lead">{product.summary}</p>
        <div class="hero-actions">
          <a
            class="button button--primary"
            href={`/${locale}/contact/?process=${product.slug}`}
          >
            {copy.inquiry}<span aria-hidden="true">→</span>
          </a>
          <a class="button button--secondary" href={`/${locale}/solutions/`}>
            {copy.allProducts}
          </a>
        </div>
      </div>
      <div class="product-hero__index" aria-hidden="true">
        <span>{String(currentIndex + 1).padStart(2, "0")}</span>
        <small>PLACHEM PRODUCT SOLUTION</small>
      </div>
    </div>
  </section>

  <section class="section overview-section">
    <div class="container overview-grid">
      <figure>
        <img
          src={productVisuals[slug]}
          alt={copy.imageAlt}
          width="1200"
          height="900"
          loading="eager"
        />
        <figcaption>{copy.concept}</figcaption>
      </figure>
      <div class="overview-copy">
        <p class="kicker">{copy.overviewKicker}</p>
        <h2>{copy.overviewTitle}</h2>
        <p class="lead">{product.overview}</p>
        <p>{copy.overviewLead}</p>
        <dl>
          <div>
            <dt>{copy.handled}</dt>
            <dd>{product.materials.join(" · ")}</dd>
          </div>
          <div>
            <dt>{copy.processScope}</dt>
            <dd>{product.processes.join(" · ")}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section checks-section">
    <div class="container section-heading">
      <div>
        <p class="kicker">{copy.checksKicker}</p>
        <h2>{copy.checksTitle}</h2>
      </div>
      <p>{copy.checksLead}</p>
    </div>
    <ol class="container numbered-grid">
      {
        product.checks.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{item}</strong>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section issues-section">
    <div class="container section-heading">
      <div>
        <p class="kicker">{copy.issuesKicker}</p>
        <h2>{copy.issuesTitle}</h2>
      </div>
      <p>{copy.issuesLead}</p>
    </div>
    <div class="container issues-grid">
      {
        product.issues.map((issue, index) => (
          <article class="issue-card">
            <header>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{issue.symptom}</h3>
            </header>
            <dl>
              <div>
                <dt>{copy.causes}</dt>
                <dd>{issue.causes}</dd>
              </div>
              <div>
                <dt>{copy.action}</dt>
                <dd>{issue.action}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section support-section">
    <div class="container support-grid">
      <div>
        <p class="kicker">{copy.supportKicker}</p>
        <h2>{copy.supportTitle}</h2>
        <p>{copy.supportLead}</p>
      </div>
      <ol>
        {
          product.support.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item}</strong>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section related-section">
    <div class="container">
      <p class="kicker">{copy.relatedKicker}</p>
      <h2>{copy.relatedTitle}</h2>
      <div class="related-grid">
        {
          solutionProducts.map((item, index) => (
            <a
              href={`/${locale}/products/${item.slug}/`}
              class:list={{ "is-current": item.slug === slug }}
              aria-current={item.slug === slug ? "page" : undefined}
            >
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item.title}</strong>
              <small>
                {item.slug === slug ? copy.currentProduct : copy.viewDetails}
                <span aria-hidden="true">{item.slug === slug ? "●" : "→"}</span>
              </small>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section final-section">
    <div class="container">
      <CTAPanel
        title={copy.ctaTitle}
        summary={copy.ctaSummary}
        ctas={[
          {
            label: product.cta,
            href: `/${locale}/contact/?process=${product.slug}`,
            variant: "primary",
          },
          {
            label: copy.allProducts,
            href: `/${locale}/solutions/`,
            variant: "secondary",
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .product-hero {
    background:
      linear-gradient(
        90deg,
        rgba(3, 15, 33, 0.98),
        rgba(5, 24, 49, 0.84) 52%,
        rgba(5, 24, 49, 0.45)
      ),
      var(--product-image) center / cover no-repeat;
    color: white;
    min-height: clamp(500px, 58vw, 680px);
    overflow: hidden;
    position: relative;
  }
  .product-hero::after {
    background-image:
      linear-gradient(rgba(105, 173, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(105, 173, 255, 0.08) 1px, transparent 1px);
    background-size: 72px 72px;
    content: "";
    inset: 0;
    mask-image: linear-gradient(90deg, black, transparent 75%);
    pointer-events: none;
    position: absolute;
  }
  .product-hero__inner {
    align-items: end;
    display: grid;
    gap: 3rem;
    min-height: inherit;
    padding-block: clamp(5rem, 10vw, 8rem) clamp(3.5rem, 7vw, 6rem);
    position: relative;
    z-index: 1;
  }
  .breadcrumb {
    color: #b9cee4;
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 800;
    margin-bottom: 2rem;
    text-decoration: none;
  }
  .eyebrow,
  .kicker {
    color: #73b5ff;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(3.2rem, 7vw, 6.4rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
    margin: 0;
    max-width: 12ch;
  }
  .product-hero .lead {
    color: #d4dfeb;
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    line-height: 1.8;
    margin: 1.5rem 0 0;
    max-width: 58ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .hero-actions .button {
    gap: 1.2rem;
  }
  .hero-actions .button--primary {
    background: #176ee0;
    border-color: #176ee0;
  }
  .hero-actions .button--secondary {
    background: rgba(5, 24, 49, 0.45);
    border-color: rgba(255, 255, 255, 0.5);
    color: white;
  }
  .product-hero__index {
    align-self: center;
    border-left: 4px solid #2d83ea;
    display: grid;
    padding: 1.5rem;
  }
  .product-hero__index span {
    color: white;
    font-size: clamp(4rem, 9vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 0.85;
  }
  .product-hero__index small {
    color: #8fb7df;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    margin-top: 1.2rem;
  }
  .section {
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }
  h2 {
    color: var(--color-navy);
    font-size: clamp(2rem, 4.4vw, 3.8rem);
    letter-spacing: -0.04em;
    line-height: 1.08;
    margin: 0;
  }
  p {
    margin: 0;
  }
  .overview-section {
    background: white;
  }
  .overview-grid,
  .section-heading,
  .support-grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
  }
  .overview-grid figure {
    box-shadow: 1.4rem 1.4rem 0 #dfe8f1;
    margin: 0;
    min-height: 380px;
    overflow: hidden;
    position: relative;
  }
  .overview-grid img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  figcaption {
    background: rgba(5, 24, 49, 0.86);
    bottom: 0;
    color: white;
    font-size: 0.7rem;
    left: 0;
    padding: 0.55rem 0.8rem;
    position: absolute;
  }
  .overview-copy {
    align-self: center;
  }
  .overview-copy .kicker,
  .checks-section .kicker,
  .issues-section .kicker,
  .related-section .kicker {
    color: #176ee0;
  }
  .overview-copy .lead {
    color: #34475a;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.8;
    margin-top: 1.5rem;
  }
  .overview-copy > p:last-of-type {
    color: #667587;
    line-height: 1.8;
    margin-top: 1rem;
  }
  dl {
    border-top: 1px solid #d5dfe9;
    display: grid;
    gap: 1.2rem;
    margin: 2rem 0 0;
    padding-top: 1.5rem;
  }
  dt {
    color: #176ee0;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.06em;
  }
  dd {
    color: #425568;
    line-height: 1.7;
    margin: 0.35rem 0 0;
  }
  .checks-section {
    background: #eef3f8;
  }
  .section-heading > p {
    align-self: end;
    color: #5d6d7f;
    line-height: 1.8;
  }
  .numbered-grid {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin-top: 3rem;
    padding: 0 20px;
  }
  .numbered-grid li {
    background: white;
    border-top: 4px solid #176ee0;
    display: grid;
    min-height: 170px;
    padding: 1.4rem;
  }
  .numbered-grid span,
  .support-grid li span,
  .related-grid span {
    color: #176ee0;
    font-size: 0.72rem;
    font-weight: 900;
  }
  .numbered-grid strong {
    align-self: end;
    color: var(--color-navy);
    font-size: 1.08rem;
  }
  .issues-section {
    background: white;
  }
  .issues-grid {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
  }
  .issue-card {
    border: 1px solid #d6e0ea;
    border-top: 4px solid #176ee0;
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }
  .issue-card header {
    align-items: baseline;
    display: grid;
    gap: 1rem;
    grid-template-columns: 2rem 1fr;
  }
  .issue-card header span {
    color: #176ee0;
    font-size: 0.72rem;
    font-weight: 900;
  }
  .issue-card h3 {
    color: var(--color-navy);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    margin: 0;
  }
  .issue-card dl {
    gap: 1rem;
    margin-left: 3rem;
  }
  .issue-card dt {
    color: #53687d;
  }
  .issue-card dd {
    color: #263d54;
    font-size: 0.94rem;
  }
  .support-section {
    background: #07182f;
    color: white;
  }
  .support-section h2 {
    color: white;
  }
  .support-grid > div > p:last-child {
    color: #bdccdc;
    line-height: 1.8;
    margin-top: 1.5rem;
  }
  .support-grid ol {
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .support-grid li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    display: grid;
    gap: 1rem;
    grid-template-columns: 2.5rem 1fr;
    padding: 1.35rem 0;
  }
  .related-section {
    background: white;
  }
  .related-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .related-grid a {
    background: #f2f6fa;
    border-top: 3px solid #d2dce6;
    display: grid;
    min-height: 160px;
    padding: 1.25rem;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }
  .related-grid a:hover {
    border-color: #176ee0;
    transform: translateY(-3px);
  }
  .related-grid a.is-current {
    background: #e7f1ff;
    border-color: #176ee0;
    box-shadow: inset 0 0 0 1px rgba(23, 110, 224, 0.16);
    cursor: default;
  }
  .related-grid a.is-current:hover {
    transform: none;
  }
  .related-grid strong {
    align-self: center;
    color: var(--color-navy);
    font-size: 1.05rem;
  }
  .related-grid small {
    align-items: center;
    color: #176ee0;
    display: flex;
    font-weight: 900;
    gap: 0.45rem;
  }
  .related-grid small span {
    font-size: 0.58rem;
  }
  .final-section {
    background: #e8eef5;
  }
  @media (min-width: 48rem) {
    .product-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(220px, 0.32fr);
    }
    .overview-grid,
    .section-heading,
    .support-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .numbered-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-inline: var(--space-6);
    }
    .issues-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
