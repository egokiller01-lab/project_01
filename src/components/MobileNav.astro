---
import { navigation } from '../data/navigation';
import type { Locale } from '../types';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
---

<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" data-mobile-nav data-open="false">
  {navigation[locale].map((item) => <a href={item.href}>{item.label}</a>)}
  <a class="button button--primary" href={`/${locale}/#contact`}>Contact</a>
</nav>

<style>
  .mobile-nav {
    background: white;
    border-bottom: var(--border);
    display: grid;
    gap: var(--space-2);
    left: 0;
    padding: var(--space-4);
    position: fixed;
    right: 0;
    top: 72px;
    transform: translateY(-110%);
    transition: transform var(--transition);
    z-index: var(--z-menu);
  }

  .mobile-nav[data-open='true'] {
    transform: translateY(0);
  }

  .mobile-nav a {
    border-radius: var(--radius-md);
    min-height: 44px;
    padding: var(--space-3);
    text-decoration: none;
  }

  @media (min-width: 64rem) {
    .mobile-nav {
      display: none;
    }
  }
</style>
