---
import type { CTA } from "../types";

type Props = {
  eyebrow: string;
  titleLines: string[];
  accent: string;
  summary: string;
  ctas: CTA[];
  strengths: string[];
  visualLabel: string;
  metricsLabel: string;
  imageSrc: string;
  imageAlt: string;
};

const {
  eyebrow,
  titleLines,
  accent,
  summary,
  ctas,
  strengths,
  visualLabel,
  metricsLabel,
  imageSrc,
  imageAlt,
} = Astro.props;
---

<section class="hero" aria-label={visualLabel}>
  <div class="hero-media">
    <img
      src={imageSrc}
      alt={imageAlt}
      width="1680"
      height="945"
      fetchpriority="high"
    />
  </div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span></span>{eyebrow}</p>
      <h1>
        {titleLines.map((line) => <span>{line}</span>)}
        <span class="accent">{accent}</span>
      </h1>
      <p class="summary">{summary}</p>
      <div class="hero-actions">
        {
          ctas.map((cta) => (
            <a
              class={`button button--${cta.variant ?? "secondary"}`}
              href={cta.href}
            >
              {cta.label}
              <span aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
    <aside class="hero-signal">
      <span>BAC NINH · VIETNAM</span>
      <small>LOCAL MANUFACTURING</small>
      <strong>PROCESS-FOCUSED<br />TECHNICAL SUPPORT</strong>
    </aside>
  </div>
  <div class="container hero-metrics" aria-label={metricsLabel}>
    {
      strengths.map((item, index) => (
        <div>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{item}</strong>
        </div>
      ))
    }
  </div>
</section>

<style>
  .hero {
    background: #06152a;
    color: white;
    overflow: hidden;
    padding-block: clamp(5.5rem, 10vw, 9rem) 0;
    position: relative;
  }

  .hero::before {
    background:
      linear-gradient(
        90deg,
        rgba(4, 16, 34, 0.99) 0%,
        rgba(5, 20, 42, 0.9) 40%,
        rgba(5, 20, 42, 0.28) 74%,
        rgba(5, 20, 42, 0.58) 100%
      ),
      linear-gradient(180deg, transparent 45%, #06152a 100%);
    content: "";
    inset: 0;
    position: absolute;
    z-index: 1;
  }

  .hero::after {
    background-image:
      linear-gradient(rgba(105, 173, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(105, 173, 255, 0.1) 1px, transparent 1px);
    background-size: 72px 72px;
    content: "";
    inset: 0;
    mask-image: linear-gradient(90deg, black, transparent 60%);
    opacity: 0.35;
    position: absolute;
    z-index: 1;
  }

  .hero-media {
    inset: 0;
    position: absolute;
  }

  .hero-media img {
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    width: 100%;
  }

  .hero-grid {
    align-items: end;
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
    min-height: 500px;
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    align-items: center;
    color: #82bdff;
    display: flex;
    font-size: 0.76rem;
    font-weight: 900;
    gap: 0.75rem;
    letter-spacing: 0.12em;
    margin: 0 0 var(--space-5);
  }

  .eyebrow span {
    background: #69adff;
    display: block;
    height: 2px;
    width: 2rem;
  }

  h1 {
    color: white;
    font-size: clamp(3rem, 5.7vw, 5.5rem);
    letter-spacing: -0.05em;
    line-height: 1.01;
    margin: 0;
    text-shadow: 0 0.5rem 2rem rgba(2, 10, 22, 0.35);
  }

  :global(html[lang="en"]) h1,
  :global(html[lang="vi"]) h1 {
    font-size: clamp(2.55rem, 4.8vw, 4.75rem);
  }

  h1 span {
    display: block;
  }

  .accent {
    color: #69adff;
  }

  .summary {
    color: #d1ddeb;
    font-size: clamp(1.04rem, 1.6vw, 1.2rem);
    line-height: 1.8;
    margin-block: var(--space-5);
    max-width: 43rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-actions .button {
    gap: 1.4rem;
    padding-inline: 1.35rem;
  }

  .hero-actions .button--primary {
    background: #176ee0;
    border-color: #176ee0;
    box-shadow: 0 0.8rem 2rem rgba(12, 91, 201, 0.32);
  }

  .hero-actions .button--secondary {
    backdrop-filter: blur(10px);
    background: rgba(5, 20, 42, 0.38);
    border-color: rgba(255, 255, 255, 0.48);
    color: white;
  }

  .hero-signal {
    align-self: center;
    backdrop-filter: blur(10px);
    background: rgba(4, 20, 43, 0.62);
    border: 1px solid rgba(130, 189, 255, 0.35);
    border-left: 3px solid #69adff;
    display: grid;
    min-height: 190px;
    padding: 1.5rem;
  }

  .hero-signal > span {
    color: #82bdff;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .hero-signal small {
    align-self: end;
    color: #91a9c3;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.11em;
  }

  .hero-signal strong {
    color: white;
    font-size: clamp(1rem, 1.7vw, 1.35rem);
    line-height: 1.25;
    margin-top: 0.4rem;
  }

  .hero-metrics {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    display: grid;
    gap: var(--space-3);
    margin-top: clamp(3rem, 7vw, 5.5rem);
    padding-block: 1.4rem;
    position: relative;
    z-index: 2;
  }

  .hero-metrics div {
    align-items: baseline;
    display: flex;
    gap: 0.8rem;
  }

  .hero-metrics span {
    color: #69adff;
    font-size: 0.7rem;
    font-weight: 900;
  }

  .hero-metrics strong {
    color: white;
    font-size: 0.9rem;
  }

  @media (min-width: 48rem) {
    .hero-metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.68fr) minmax(14rem, 0.32fr);
    }
  }

  @media (max-width: 63.99rem) {
    .hero-signal {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    .hero {
      padding-top: 4.5rem;
    }

    .hero::before {
      background:
        linear-gradient(90deg, rgba(4, 16, 34, 0.96), rgba(5, 20, 42, 0.66)),
        linear-gradient(180deg, transparent 30%, #06152a 100%);
    }

    .hero-grid {
      min-height: 490px;
    }

    .hero-actions .button {
      flex: 1 1 150px;
    }
  }
</style>
