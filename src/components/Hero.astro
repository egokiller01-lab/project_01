---
import type { CTA } from '../types';

type Props = {
  eyebrow: string;
  title: string;
  summary: string;
  ctas: CTA[];
  strengths: string[];
};

const { eyebrow, title, summary, ctas, strengths } = Astro.props;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <div class="hero-actions">
        {ctas.map((cta) => <a class={`button button--${cta.variant ?? 'secondary'}`} href={cta.href}>{cta.label}</a>)}
      </div>
    </div>
    <div class="hero-panel" aria-label="PLACHEM VINA process support strengths">
      <div class="process-visual" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="strength-list">
        {strengths.map((strength) => <span>{strength}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      linear-gradient(180deg, white 0%, var(--color-light) 100%);
    border-bottom: var(--border);
    padding-block: calc(var(--space-8) + var(--space-4));
  }

  .hero-grid {
    display: grid;
    gap: var(--space-6);
  }

  .eyebrow {
    color: var(--color-blue);
    font-weight: 800;
    margin: 0 0 var(--space-3);
  }

  h1 {
    color: var(--color-navy);
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
    max-width: 13ch;
  }

  .summary {
    font-size: 1.18rem;
    margin-block: var(--space-5);
    max-width: 64ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-panel {
    background: white;
    border: var(--border);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    box-shadow: var(--shadow);
  }

  .process-visual {
    background: var(--color-light);
    border: var(--border);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .process-visual span {
    background: var(--color-navy);
    border-radius: var(--radius-sm);
    display: block;
    height: 1rem;
    position: relative;
  }

  .process-visual span:nth-child(2) {
    background: var(--color-blue);
    margin-left: var(--space-5);
  }

  .process-visual span:nth-child(3) {
    margin-left: var(--space-7);
  }

  .strength-list {
    display: grid;
    gap: var(--space-3);
  }

  .strength-list span {
    border: var(--border);
    border-radius: var(--radius-sm);
    color: var(--color-navy);
    font-weight: 800;
    padding: var(--space-3);
  }

  @media (min-width: 64rem) {
    .hero-grid {
      align-items: center;
      grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.7fr);
    }
  }
</style>
