---
import type { CTA } from "../types";

type Props = {
  eyebrow: string;
  titleLines: string[];
  accent: string;
  summary: string;
  ctas: CTA[];
  strengths: string[];
};

const { eyebrow, titleLines, accent, summary, ctas, strengths } = Astro.props;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>
        {titleLines.map((line) => <span>{line}</span>)}
        <span class="accent">{accent}</span>
      </h1>
      <p class="summary">{summary}</p>
      <div class="hero-actions">
        {
          ctas.map((cta) => (
            <a
              class={`button button--${cta.variant ?? "secondary"}`}
              href={cta.href}
            >
              {cta.label}
            </a>
          ))
        }
      </div>
    </div>
    <div class="metal-visual" aria-label="정밀 금속 표면을 표현한 비주얼">
      <div class="metal-plate">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="visual-label">
        <strong>PRECISION SURFACE</strong>
        <span>CHEMISTRY</span>
      </div>
    </div>
  </div>
  <div class="container hero-metrics" aria-label="PLACHEM VINA summary">
    {strengths.map((item) => <span>{item}</span>)}
  </div>
</section>

<style>
  .hero {
    background:
      linear-gradient(rgba(192, 199, 209, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(192, 199, 209, 0.16) 1px, transparent 1px),
      linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    background-size:
      44px 44px,
      44px 44px,
      auto;
    border-bottom: var(--border);
    padding-block: clamp(4rem, 8vw, 6.25rem) var(--space-6);
  }

  .hero-grid {
    align-items: center;
    display: grid;
    gap: var(--space-7);
    min-height: 560px;
  }

  .eyebrow {
    color: var(--color-blue);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-4);
  }

  h1 {
    color: var(--color-navy);
    font-size: clamp(42px, 5vw, 68px);
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
  }

  h1 span {
    display: block;
  }

  .accent {
    color: var(--color-blue);
  }

  .summary {
    font-size: clamp(1.04rem, 1.6vw, 1.22rem);
    margin-block: var(--space-5);
    max-width: 42rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-actions .button--primary {
    background: var(--color-blue);
    border-color: var(--color-blue);
  }

  .metal-visual {
    background:
      linear-gradient(135deg, rgba(11, 31, 58, 0.96), rgba(31, 78, 121, 0.72)),
      var(--color-navy);
    border: 1px solid rgba(192, 199, 209, 0.8);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow);
    min-height: 380px;
    overflow: hidden;
    padding: var(--space-5);
    position: relative;
  }

  .metal-visual::before {
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.24),
        transparent
      ),
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.08) 0 1px,
        transparent 1px 12px
      );
    content: "";
    inset: 0;
    opacity: 0.68;
    position: absolute;
  }

  .metal-plate {
    background:
      radial-gradient(
        circle at 18% 35%,
        rgba(255, 255, 255, 0.85),
        transparent 0.55rem
      ),
      radial-gradient(
        circle at 78% 28%,
        rgba(255, 255, 255, 0.82),
        transparent 0.5rem
      ),
      linear-gradient(
        135deg,
        #f8fafc 0%,
        #c0c7d1 38%,
        #ffffff 52%,
        #7f8fa3 100%
      );
    clip-path: polygon(8% 16%, 84% 8%, 96% 62%, 58% 88%, 12% 78%);
    height: 250px;
    left: 9%;
    position: absolute;
    right: 8%;
    top: 15%;
  }

  .metal-plate span {
    background: rgba(11, 31, 58, 0.22);
    border: 1px solid rgba(11, 31, 58, 0.12);
    display: block;
    height: 10px;
    left: 18%;
    position: absolute;
    right: 16%;
  }

  .metal-plate span:nth-child(1) {
    top: 32%;
  }

  .metal-plate span:nth-child(2) {
    top: 50%;
  }

  .metal-plate span:nth-child(3) {
    top: 68%;
  }

  .visual-label {
    background: var(--color-navy);
    bottom: var(--space-5);
    color: white;
    display: grid;
    gap: var(--space-1);
    left: var(--space-5);
    padding: var(--space-4);
    position: absolute;
    width: min(260px, calc(100% - var(--space-6)));
  }

  .visual-label strong {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .visual-label span {
    color: var(--color-steel);
    font-weight: 900;
  }

  .hero-metrics {
    border-top: var(--border);
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
  }

  .hero-metrics span {
    color: var(--color-navy);
    font-weight: 900;
  }

  @media (min-width: 48rem) {
    .hero-metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.46fr) minmax(0, 0.54fr);
    }
  }

  @media (max-width: 47.99rem) {
    .hero {
      padding-block: var(--space-6) var(--space-5);
    }

    .hero-grid {
      min-height: auto;
    }

    .metal-visual {
      min-height: 300px;
    }

    .metal-plate {
      height: 190px;
    }
  }
</style>
