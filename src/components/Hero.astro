---
import type { CTA } from "../types";

type Props = {
  eyebrow: string;
  titleLines: string[];
  accent: string;
  summary: string;
  ctas: CTA[];
  strengths: string[];
  visualLabel: string;
  metricsLabel: string;
  imageSrc: string;
  imageAlt: string;
};

const {
  eyebrow,
  titleLines,
  accent,
  summary,
  ctas,
  strengths,
  visualLabel,
  metricsLabel,
  imageSrc,
  imageAlt,
} = Astro.props;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span></span>{eyebrow}</p>
      <h1>
        {titleLines.map((line) => <span>{line}</span>)}
        <span class="accent">{accent}</span>
      </h1>
      <p class="summary">{summary}</p>
      <div class="hero-actions">
        {
          ctas.map((cta) => (
            <a
              class={`button button--${cta.variant ?? "secondary"}`}
              href={cta.href}
            >
              {cta.label}
              <span aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
    <figure class="hero-visual" aria-label={visualLabel}>
      <img
        src={imageSrc}
        alt={imageAlt}
        width="1680"
        height="945"
        fetchpriority="high"
      />
      <span class="visual-location">BAC NINH · VIETNAM</span>
      <figcaption>
        <span>PRECISION SURFACE</span>
        <strong>CHEMISTRY</strong>
      </figcaption>
    </figure>
  </div>
  <div class="container hero-metrics" aria-label={metricsLabel}>
    {
      strengths.map((item, index) => (
        <div>
          <>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{item}</strong>
          </>
        </div>
      ))
    }
  </div>
</section>

<style>
  .hero {
    background:
      linear-gradient(rgba(192, 199, 209, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(192, 199, 209, 0.12) 1px, transparent 1px),
      linear-gradient(125deg, #ffffff 0%, #f2f6fb 70%, #e7eef8 100%);
    background-size:
      48px 48px,
      48px 48px,
      auto;
    border-bottom: var(--border);
    overflow: hidden;
    padding-block: clamp(3.5rem, 7vw, 6.5rem) var(--space-6);
    position: relative;
  }

  .hero::after {
    border: 1px solid rgba(28, 114, 214, 0.1);
    border-radius: 50%;
    content: "";
    height: 34rem;
    left: -18rem;
    position: absolute;
    top: -15rem;
    width: 34rem;
  }

  .hero-grid {
    align-items: center;
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    min-height: 560px;
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    align-items: center;
    color: #2366b2;
    display: flex;
    font-size: 0.76rem;
    font-weight: 900;
    gap: 0.75rem;
    letter-spacing: 0.12em;
    margin: 0 0 var(--space-5);
  }

  .eyebrow span {
    background: var(--color-blue);
    display: block;
    height: 2px;
    width: 2rem;
  }

  h1 {
    color: var(--color-navy);
    font-size: clamp(2.7rem, 5.3vw, 4.7rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
    margin: 0;
  }

  :global(html[lang="en"]) h1,
  :global(html[lang="vi"]) h1 {
    font-size: clamp(2.45rem, 4.6vw, 4.15rem);
  }

  h1 span {
    display: block;
  }
  .accent {
    color: #1c72d6;
  }

  .summary {
    color: #536173;
    font-size: clamp(1.04rem, 1.6vw, 1.2rem);
    line-height: 1.85;
    margin-block: var(--space-5);
    max-width: 42rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero-actions .button {
    gap: 1.4rem;
    padding-inline: 1.35rem;
  }
  .hero-actions .button--primary {
    background: #1c72d6;
    border-color: #1c72d6;
  }

  .hero-visual {
    background: var(--color-navy);
    box-shadow: 0 2.2rem 4rem rgba(11, 31, 58, 0.22);
    margin: 0;
    min-height: 410px;
    overflow: hidden;
    position: relative;
  }

  .hero-visual::before {
    border-left: 3px solid #4b9cf1;
    content: "";
    height: 34%;
    left: 0;
    position: absolute;
    top: 0;
    z-index: 2;
  }

  .hero-visual::after {
    background: linear-gradient(
      180deg,
      transparent 45%,
      rgba(3, 14, 29, 0.86) 100%
    );
    content: "";
    inset: 0;
    position: absolute;
  }

  .hero-visual img {
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    width: 100%;
  }

  .visual-location {
    background: rgba(7, 23, 45, 0.78);
    color: white;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    padding: 0.7rem 0.8rem;
    position: absolute;
    right: var(--space-4);
    top: var(--space-4);
    z-index: 2;
  }

  figcaption {
    bottom: var(--space-5);
    color: white;
    display: grid;
    left: var(--space-5);
    position: absolute;
    z-index: 1;
  }

  figcaption span {
    font-size: 0.67rem;
    letter-spacing: 0.17em;
    opacity: 0.72;
  }
  figcaption strong {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    letter-spacing: 0.03em;
  }

  .hero-metrics {
    border-top: 1px solid rgba(120, 139, 164, 0.35);
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    position: relative;
    z-index: 1;
  }

  .hero-metrics div {
    align-items: baseline;
    display: flex;
    gap: 0.8rem;
  }
  .hero-metrics span {
    color: #1c72d6;
    font-size: 0.7rem;
    font-weight: 900;
  }
  .hero-metrics strong {
    color: var(--color-navy);
    font-size: 0.93rem;
  }

  @media (min-width: 48rem) {
    .hero-metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.46fr) minmax(0, 0.54fr);
    }
    .hero-visual {
      min-height: 500px;
    }
  }

  @media (max-width: 47.99rem) {
    .hero {
      padding-block: 2.6rem var(--space-5);
    }
    .hero-grid {
      gap: var(--space-6);
      min-height: auto;
    }
    .hero-visual {
      min-height: 280px;
    }
    .hero-actions .button {
      flex: 1 1 150px;
    }
  }
</style>
