---
import type { CTA } from "../types";

type Props = {
  eyebrow: string;
  title: string;
  summary: string;
  ctas: CTA[];
  strengths: string[];
  image: {
    src: string;
    alt: string;
    caption: string;
  };
};

const { eyebrow, title, summary, ctas, strengths, image } = Astro.props;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <div class="hero-actions">
        {
          ctas.map((cta) => (
            <a
              class={`button button--${cta.variant ?? "secondary"}`}
              href={cta.href}
            >
              {cta.label}
            </a>
          ))
        }
      </div>
    </div>
    <div class="hero-panel" aria-label="PLACHEM VINA process support strengths">
      <figure class="hero-media">
        <img
          src={image.src}
          alt={image.alt}
          width="1024"
          height="1024"
          loading="eager"
          decoding="async"
        />
        <figcaption>{image.caption}</figcaption>
      </figure>
      <div class="strength-list">
        {strengths.map((strength) => <span>{strength}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(
        circle at 15% 0%,
        rgba(29, 78, 216, 0.12),
        transparent 28rem
      ),
      linear-gradient(180deg, white 0%, var(--color-light) 100%);
    border-bottom: var(--border);
    padding-block: var(--space-7);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-6);
  }

  .eyebrow {
    color: var(--color-blue);
    font-size: 0.86rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-3);
    text-transform: uppercase;
  }

  h1 {
    color: var(--color-navy);
    font-size: clamp(2.35rem, 5vw, 4.6rem);
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
    max-width: 14ch;
  }

  .summary {
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    margin-block: var(--space-5);
    max-width: 56ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-panel {
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(192, 199, 209, 0.8);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-4);
    overflow: hidden;
    padding: var(--space-3);
    box-shadow: var(--shadow);
  }

  .hero-media {
    margin: 0;
    position: relative;
  }

  .hero-media img {
    aspect-ratio: 4 / 3;
    border-radius: calc(var(--radius-md) - 2px);
    display: block;
    height: auto;
    object-fit: cover;
    object-position: 48% 50%;
    width: 100%;
  }

  .hero-media figcaption {
    background: rgba(11, 31, 58, 0.9);
    border-radius: var(--radius-sm);
    bottom: var(--space-3);
    color: white;
    font-size: 0.78rem;
    font-weight: 700;
    left: var(--space-3);
    max-width: calc(100% - var(--space-6));
    padding: 0.45rem 0.65rem;
    position: absolute;
  }

  .strength-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0 var(--space-2) var(--space-2);
  }

  .strength-list span {
    background: var(--color-light);
    border: 1px solid rgba(192, 199, 209, 0.75);
    border-radius: var(--radius-sm);
    color: var(--color-navy);
    font-size: 0.86rem;
    font-weight: 800;
    padding: 0.55rem 0.7rem;
  }

  @media (min-width: 64rem) {
    .hero-grid {
      align-items: center;
      grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.7fr);
    }
  }
</style>
