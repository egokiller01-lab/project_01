---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MobileNav from "./MobileNav.astro";
import { navigation } from "../data/navigation";
import type { Locale } from "../types";

type Props = {
  locale: Locale;
  currentPath: string;
  alternatePaths: Record<Locale, string>;
};

const { locale, currentPath, alternatePaths } = Astro.props;
const items = navigation[locale];
const contactLabels = {
  ko: "기술문의",
  en: "Contact",
  vi: "Liên hệ",
}[locale];
const a11yLabels = {
  ko: {
    home: "PLACHEM VINA 홈",
    nav: "주요 메뉴",
    menu: "메뉴 열기",
  },
  en: {
    home: "PLACHEM VINA home",
    nav: "Primary navigation",
    menu: "Open menu",
  },
  vi: {
    home: "Trang chủ PLACHEM VINA",
    nav: "Điều hướng chính",
    menu: "Mở menu",
  },
}[locale];

function isActive(href: string) {
  return (
    currentPath === href ||
    (href.includes("/solutions/") &&
      currentPath.startsWith(`/${locale}/solutions/`))
  );
}
---

<header class="site-header">
  <div class="top-strip">
    <div class="container top-strip__inner">
      <span>BAC NINH · VIETNAM</span>
      <span>PRECISION SURFACE TREATMENT CHEMICAL SOLUTIONS</span>
    </div>
  </div>
  <div class="main-header">
    <div class="container header-inner">
      <a class="brand" href={`/${locale}/`} aria-label={a11yLabels.home}>
        <span>PLACHEM</span>
        <small>VINA CO., LTD.</small>
      </a>
      <nav class="desktop-nav" aria-label={a11yLabels.nav}>
        {
          items.map((item) => (
            <a
              href={item.href}
              class={isActive(item.href) ? "is-active" : ""}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
            >
              {item.label}
              {item.external && <span class="external-mark" aria-hidden="true">↗</span>}
            </a>
          ))
        }
      </nav>
      <div class="header-actions">
        <LanguageSwitcher locale={locale} alternatePaths={alternatePaths} />
        <a class="header-cta" href={`/${locale}/contact/`}>
          <span>{contactLabels}</span>
          <span aria-hidden="true">→</span>
        </a>
        <button
          class="menu-button"
          type="button"
          aria-controls="mobile-nav"
          aria-expanded="false"
          data-menu-button
        >
          <span class="menu-button__line"></span>
          <span class="menu-button__line"></span>
          <span class="menu-button__line"></span>
          <span class="sr-only">{a11yLabels.menu}</span>
        </button>
      </div>
    </div>
    <MobileNav
      locale={locale}
      currentPath={currentPath}
      alternatePaths={alternatePaths}
    />
  </div>
</header>

<script>
  const menuButton = document.querySelector("[data-menu-button]");
  const mobileNav = document.querySelector("[data-mobile-nav]");

  function closeMenu() {
    menuButton?.setAttribute("aria-expanded", "false");
    mobileNav?.setAttribute("data-open", "false");
    mobileNav?.setAttribute("inert", "");
    document.body.classList.remove("menu-open");
  }

  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!isOpen));
    mobileNav?.setAttribute("data-open", String(!isOpen));
    if (isOpen) {
      mobileNav?.setAttribute("inert", "");
    } else {
      mobileNav?.removeAttribute("inert");
    }
    document.body.classList.toggle("menu-open", !isOpen);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>

<style>
  .site-header {
    background: rgba(5, 20, 42, 0.97);
    box-shadow: 0 0.45rem 1.6rem rgba(2, 10, 22, 0.22);
    position: sticky;
    top: 0;
    z-index: var(--z-header);
  }

  .top-strip {
    background: #041226;
    color: white;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .top-strip__inner {
    align-items: center;
    display: flex;
    justify-content: space-between;
    min-height: 32px;
  }

  .main-header {
    backdrop-filter: blur(14px);
    background: rgba(7, 25, 50, 0.94);
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }

  .header-inner {
    align-items: center;
    display: flex;
    gap: var(--space-4);
    min-height: 82px;
  }

  .brand {
    color: white;
    display: grid;
    font-weight: 900;
    line-height: 1;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration: none;
  }

  .brand::before {
    background: linear-gradient(
      90deg,
      #1c72d6 0 42%,
      #91bce8 42% 64%,
      #d9e4ef 64%
    );
    content: "";
    height: 3px;
    margin-bottom: 0.48rem;
    width: 2.8rem;
  }

  .brand span {
    font-size: 1.18rem;
    letter-spacing: 0.02em;
  }

  .brand small {
    color: #8fa9c5;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    margin-top: 0.25rem;
  }

  .desktop-nav {
    display: none;
    gap: var(--space-4);
    margin-left: auto;
  }

  .desktop-nav a {
    color: #e8eef6;
    font-size: 0.96rem;
    font-weight: 800;
    padding-block: 1.85rem;
    position: relative;
    text-decoration: none;
  }

  .external-mark {
    color: #69adff;
    font-size: 0.76em;
    margin-left: 0.3rem;
  }

  .desktop-nav a::after {
    background: #1c72d6;
    bottom: 0;
    content: "";
    height: 2px;
    left: 0;
    position: absolute;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
    width: 100%;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a.is-active::after {
    transform: scaleX(1);
  }

  .desktop-nav a.is-active {
    color: #69adff;
  }

  .header-actions {
    align-items: center;
    display: flex;
    gap: var(--space-3);
    margin-left: auto;
  }

  .header-cta {
    display: none;
    align-items: center;
    background: #176ee0;
    border: 1px solid #176ee0;
    border-radius: var(--radius-sm);
    color: white;
    gap: var(--space-2);
    font-weight: 900;
    min-height: 44px;
    padding: 0.7rem 1rem;
    text-decoration: none;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .header-cta:hover {
    background: #1c72d6;
    transform: translateY(-1px);
  }

  .menu-button {
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--radius-md);
    display: inline-flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 44px;
    justify-content: center;
    width: 44px;
  }

  .menu-button__line {
    background: white;
    display: block;
    height: 2px;
    width: 18px;
  }

  .sr-only {
    clip: rect(0, 0, 0, 0);
    border: 0;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  @media (min-width: 64rem) {
    .desktop-nav {
      display: flex;
    }

    .header-cta {
      display: inline-flex;
    }

    .menu-button {
      display: none;
    }
  }

  .header-actions :global(.language-switcher a) {
    color: #b8c8d9;
  }

  .header-actions :global(.language-switcher a.is-active) {
    color: #69adff;
  }

  @media (max-width: 30rem) {
    .top-strip__inner {
      min-height: 28px;
    }

    .top-strip__inner span:last-child {
      display: none;
    }

    .header-inner {
      min-height: 72px;
    }

    .header-inner {
      gap: var(--space-2);
    }

    .header-actions :global(.language-switcher) {
      display: none;
    }
  }
</style>
