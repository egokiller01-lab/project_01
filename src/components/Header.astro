---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MobileNav from "./MobileNav.astro";
import { navigation } from "../data/navigation";
import type { Locale } from "../types";

type Props = {
  locale: Locale;
  currentPath: string;
  alternatePaths: Record<Locale, string>;
};

const { locale, currentPath, alternatePaths } = Astro.props;
const items = navigation[locale];
const contactLabels = {
  ko: "기술문의",
  en: "Contact",
  vi: "Liên hệ",
}[locale];
const a11yLabels = {
  ko: {
    home: "PLACHEM VINA 홈",
    nav: "주요 메뉴",
    menu: "메뉴 열기",
  },
  en: {
    home: "PLACHEM VINA home",
    nav: "Primary navigation",
    menu: "Open menu",
  },
  vi: {
    home: "Trang chủ PLACHEM VINA",
    nav: "Điều hướng chính",
    menu: "Mở menu",
  },
}[locale];

function isActive(href: string) {
  return (
    currentPath === href ||
    (href.includes("/solutions/") &&
      currentPath.startsWith(`/${locale}/solutions/`))
  );
}
---

<header class="site-header">
  <div class="top-strip">
    <div class="container top-strip__inner">
      <span>BAC NINH · VIETNAM</span>
      <span>PRECISION SURFACE TREATMENT CHEMICAL SOLUTIONS</span>
    </div>
  </div>
  <div class="main-header">
    <div class="container header-inner">
      <a class="brand" href={`/${locale}/`} aria-label={a11yLabels.home}>
        <span>PLACHEM</span>
        <small>VINA CO., LTD.</small>
      </a>
      <nav class="desktop-nav" aria-label={a11yLabels.nav}>
        {
          items.map((item) => (
            <a href={item.href} class={isActive(item.href) ? "is-active" : ""}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="header-actions">
        <LanguageSwitcher locale={locale} alternatePaths={alternatePaths} />
        <a class="header-cta" href={`/${locale}/contact/`}>
          <span>{contactLabels}</span>
          <span aria-hidden="true">→</span>
        </a>
        <button
          class="menu-button"
          type="button"
          aria-controls="mobile-nav"
          aria-expanded="false"
          data-menu-button
        >
          <span class="menu-button__line"></span>
          <span class="menu-button__line"></span>
          <span class="menu-button__line"></span>
          <span class="sr-only">{a11yLabels.menu}</span>
        </button>
      </div>
    </div>
    <MobileNav locale={locale} currentPath={currentPath} />
  </div>
</header>

<script>
  const menuButton = document.querySelector("[data-menu-button]");
  const mobileNav = document.querySelector("[data-mobile-nav]");

  function closeMenu() {
    menuButton?.setAttribute("aria-expanded", "false");
    mobileNav?.setAttribute("data-open", "false");
    mobileNav?.setAttribute("inert", "");
    document.body.classList.remove("menu-open");
  }

  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!isOpen));
    mobileNav?.setAttribute("data-open", String(!isOpen));
    if (isOpen) {
      mobileNav?.setAttribute("inert", "");
    } else {
      mobileNav?.removeAttribute("inert");
    }
    document.body.classList.toggle("menu-open", !isOpen);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>

<style>
  .site-header {
    background: white;
    position: sticky;
    top: 0;
    z-index: var(--z-header);
  }

  .top-strip {
    background: var(--color-navy);
    color: white;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .top-strip__inner {
    align-items: center;
    display: flex;
    justify-content: space-between;
    min-height: 32px;
  }

  .main-header {
    background: white;
    border-bottom: var(--border);
  }

  .header-inner {
    align-items: center;
    display: flex;
    gap: var(--space-4);
    min-height: 82px;
  }

  .brand {
    color: var(--color-navy);
    display: grid;
    font-weight: 900;
    line-height: 1;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration: none;
  }

  .brand span {
    font-size: 1.18rem;
    letter-spacing: 0.02em;
  }

  .brand small {
    color: rgba(17, 24, 39, 0.62);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    margin-top: 0.25rem;
  }

  .desktop-nav {
    display: none;
    gap: var(--space-4);
    margin-left: auto;
  }

  .desktop-nav a {
    font-size: 0.96rem;
    font-weight: 800;
    text-decoration: none;
  }

  .desktop-nav a.is-active {
    color: var(--color-blue);
  }

  .header-actions {
    align-items: center;
    display: flex;
    gap: var(--space-3);
    margin-left: auto;
  }

  .header-cta {
    display: none;
    align-items: center;
    background: var(--color-navy);
    border: 1px solid var(--color-navy);
    border-radius: var(--radius-sm);
    color: white;
    gap: var(--space-2);
    font-weight: 900;
    min-height: 44px;
    padding: 0.7rem 1rem;
    text-decoration: none;
  }

  .menu-button {
    align-items: center;
    background: white;
    border: var(--border);
    border-radius: var(--radius-md);
    display: inline-flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 44px;
    justify-content: center;
    width: 44px;
  }

  .menu-button__line {
    background: var(--color-navy);
    display: block;
    height: 2px;
    width: 18px;
  }

  .sr-only {
    clip: rect(0, 0, 0, 0);
    border: 0;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  @media (min-width: 64rem) {
    .desktop-nav {
      display: flex;
    }

    .header-cta {
      display: inline-flex;
    }

    .menu-button {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .top-strip__inner {
      min-height: 28px;
    }

    .top-strip__inner span:last-child {
      display: none;
    }

    .header-inner {
      min-height: 72px;
    }

    .header-inner {
      gap: var(--space-2);
    }

    .header-actions :global(.language-switcher) {
      display: none;
    }
  }
</style>
