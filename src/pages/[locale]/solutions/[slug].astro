---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getProduct, products, productSlugs } from "../../../data/products";
import type { Locale } from "../../../types";

export function getStaticPaths() {
  const locales: Locale[] = ["ko", "en", "vi"];

  return locales.flatMap((locale) =>
    productSlugs.map((slug) => ({
      params: { locale, slug },
      props: { locale, slug },
    })),
  );
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const pageLocales: Locale[] = ["ko", "en", "vi"];
const product = getProduct(locale, slug);

if (!product) {
  throw new Error(`Missing product content for ${locale}/${slug}`);
}

const labels = {
  ko: {
    back: "제품·솔루션으로 돌아가기",
    overview: "개요",
    materials: "적용 소재",
    process: "적용 공정",
    checks: "주요 관리 항목",
    support: "PLACHEM 기술지원 범위",
    inquiry: "Technical Inquiry",
    inquirySummary:
      "공정, 소재, 현재 증상과 요청 자료를 정리해 기술 검토를 요청할 수 있습니다.",
    seoSuffix: "제품·솔루션",
  },
  en: {
    back: "Back to Products & Solutions",
    overview: "Overview",
    materials: "Applicable Materials",
    process: "Applicable Processes",
    checks: "Key Control Items",
    support: "PLACHEM Technical Support",
    inquiry: "Technical Inquiry",
    inquirySummary:
      "Prepare process, material, symptom, and document details for technical review.",
    seoSuffix: "Products & Solutions",
  },
  vi: {
    back: "Quay lại Sản phẩm & giải pháp",
    overview: "Tổng quan",
    materials: "Vật liệu áp dụng",
    process: "Quy trình áp dụng",
    checks: "Hạng mục quản lý chính",
    support: "Phạm vi hỗ trợ kỹ thuật PLACHEM",
    inquiry: "Technical Inquiry",
    inquirySummary:
      "Chuẩn bị thông tin quy trình, vật liệu, triệu chứng và tài liệu cần kiểm tra.",
    seoSuffix: "Sản phẩm & giải pháp",
  },
}[locale];

const alternateProducts = Object.fromEntries(
  pageLocales.map((targetLocale) => [
    targetLocale,
    products[targetLocale].find((item) => item.slug === slug),
  ]),
);
---

<BaseLayout
  locale={locale}
  title={`${product.title} | PLACHEM VINA ${labels.seoSuffix}`}
  description={product.summary}
>
  <section class="product-hero">
    <div class="container product-hero__grid">
      <div>
        <a class="back-link" href={`/${locale}/#solutions`}>{labels.back}</a>
        <p class="eyebrow">{labels.seoSuffix}</p>
        <h1>{product.title}</h1>
        <p class="lead">{product.summary}</p>
      </div>
      <nav class="detail-language" aria-label="Product language links">
        {pageLocales.map((targetLocale) => {
          const targetProduct = alternateProducts[targetLocale];
          return (
            targetProduct && (
              <a
                href={`/${targetLocale}/solutions/${targetProduct.slug}/`}
                aria-current={targetLocale === locale ? "page" : undefined}
                class={targetLocale === locale ? "is-active" : ""}
              >
                {targetLocale.toUpperCase()}
              </a>
            )
          );
        })}
      </nav>
    </div>
  </section>

  <section class="section">
    <div class="container detail-layout">
      <article class="overview-panel">
        <h2>{labels.overview}</h2>
        <p>{product.overview}</p>
      </article>

      <div class="detail-grid">
        <section>
          <h2>{labels.materials}</h2>
          <ul>
            {product.materials.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section>
          <h2>{labels.process}</h2>
          <ul>
            {product.processes.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section>
          <h2>{labels.checks}</h2>
          <ul>
            {product.checks.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section>
          <h2>{labels.support}</h2>
          <ul>
            {product.support.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="inquiry-panel">
        <div>
          <h2>{labels.inquiry}</h2>
          <p>{labels.inquirySummary}</p>
        </div>
        <a class="button button--primary" href={`/${locale}/#contact`}>{product.cta}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .product-hero {
    background: var(--color-navy);
    color: white;
    padding-block: var(--space-8);
  }

  .product-hero__grid {
    display: grid;
    gap: var(--space-5);
  }

  .back-link,
  .detail-language a {
    min-height: 44px;
  }

  .back-link {
    color: white;
    display: inline-flex;
    font-weight: 800;
    margin-bottom: var(--space-5);
    text-decoration: none;
  }

  .eyebrow {
    font-weight: 800;
    margin: 0 0 var(--space-3);
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    line-height: 1.05;
    margin: 0;
    max-width: 12ch;
  }

  .lead {
    font-size: 1.18rem;
    margin: var(--space-5) 0 0;
    max-width: 54ch;
  }

  .detail-language {
    align-items: start;
    display: flex;
    gap: var(--space-2);
  }

  .detail-language a {
    border: 1px solid rgba(248, 250, 252, 0.5);
    border-radius: var(--radius-sm);
    color: white;
    display: inline-flex;
    font-weight: 800;
    justify-content: center;
    min-width: 48px;
    padding: var(--space-3);
    text-decoration: none;
  }

  .detail-language a.is-active {
    background: white;
    color: var(--color-blue);
  }

  .detail-layout {
    display: grid;
    gap: var(--space-6);
  }

  .overview-panel,
  .detail-grid section,
  .inquiry-panel {
    background: white;
    border: var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .overview-panel {
    border-left: 6px solid var(--color-blue);
  }

  .detail-grid {
    display: grid;
    gap: var(--space-4);
  }

  h2 {
    color: var(--color-navy);
    font-size: 1.25rem;
    margin: 0 0 var(--space-4);
  }

  p {
    margin: 0;
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.2rem;
  }

  .inquiry-panel {
    align-items: center;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .product-hero__grid,
    .inquiry-panel {
      align-items: start;
      grid-template-columns: 1fr auto;
    }

    .detail-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
