---
import BlogCard from '../../components/BlogCard.astro';
import CTAPanel from '../../components/CTAPanel.astro';
import Hero from '../../components/Hero.astro';
import ProcessDiagram from '../../components/ProcessDiagram.astro';
import ProductFamilyCard from '../../components/ProductFamilyCard.astro';
import QualityPanel from '../../components/QualityPanel.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SolutionCard from '../../components/SolutionCard.astro';
import TechnologyPanel from '../../components/TechnologyPanel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { homeContent } from '../../data/home';

const locale = 'en';
const content = homeContent[locale];
---

<BaseLayout locale={locale} title={content.seoTitle} description={content.description}>
  <Hero eyebrow={content.heroEyebrow} title={content.heroTitle} summary={content.heroSummary} ctas={content.primaryCtas} strengths={content.strengths} />
  <section class="section" id="company">
    <div class="container grid grid--2">
      <SectionHeading title={content.sectionLabels.company} summary="A Phase 1 static screen for validating the shared layout, design system, and multilingual data structure." />
      <TechnologyPanel title="Phase 1 scope" items={['Approved color tokens only', 'Inter + Pretendard font stack', 'No inquiry API or file upload', 'Final public copy review required']} />
    </div>
  </section>
  <section class="section section--white" id="solutions">
    <div class="container">
      <SectionHeading title={content.sectionLabels.solutions} summary="Product family cards validate process, material, and CTA structure." />
      <div class="grid grid--4">
        {content.products.map((product) => <ProductFamilyCard {...product} />)}
      </div>
    </div>
  </section>
  <section class="section" id="technology">
    <div class="container">
      <SectionHeading title={content.sectionLabels.technology} summary="Reusable components and responsive behavior are validated in this phase." />
      <ProcessDiagram steps={['Select process', 'Check material', 'Define defect type', 'Connect inquiry']} />
      <div class="grid grid--3 support-grid">
        {content.solutions.map((solution) => <SolutionCard {...solution} />)}
      </div>
    </div>
  </section>
  <section class="section section--white" id="quality">
    <div class="container grid grid--2">
      <SectionHeading title={content.sectionLabels.quality} summary="The quality section presents sample review, process checks, and LOT tracking for key supplied items." />
      <QualityPanel items={content.strengths} />
    </div>
  </section>
  <section class="section" id="knowledge">
    <div class="container">
      <SectionHeading title={content.sectionLabels.knowledge} summary="English blog links remain pending until real matching posts are verified." />
      <BlogCard title="English technical posts" href="#contact" meta="VERIFY_REQUIRED" />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <CTAPanel title={content.sectionLabels.contact} summary="Real forms, file upload, and server APIs are reserved for later phases." ctas={content.primaryCtas} />
    </div>
  </section>
</BaseLayout>

<style>
  .support-grid {
    margin-top: var(--space-5);
  }
</style>
